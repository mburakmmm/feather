# dialects.nox — Database engine dialect specifics (SQLite, PostgreSQL, MySQL).

import errors
from errors import DialectError
import metadata
from metadata import Column, Table, TYPE_INTEGER, TYPE_TEXT, TYPE_REAL, TYPE_BOOLEAN
import nox.strings

DIALECT_SQLITE: int = 1
DIALECT_POSTGRES: int = 2
DIALECT_MYSQL: int = 3

class Dialect:
    kind: int
    name: str

    def __init__(self: Dialect, kind: int, name: str) -> None:
        self.kind = kind
        self.name = name

    def quote_identifier(self: Dialect, id_name: str) -> str:

        if self.kind == DIALECT_MYSQL:
            return "`" + id_name + "`"
        return "\"" + id_name + "\""

    def placeholder(self: Dialect, idx: int) -> str:

        if self.kind == DIALECT_POSTGRES:
            return "$" + str(idx + 1)
        return "?"

    def column_base_type_sql(self: Dialect, col: Column) -> str:

        if self.kind == DIALECT_SQLITE:
            if col.data_type == TYPE_INTEGER:
                return "INTEGER"
            if col.data_type == TYPE_REAL:
                return "REAL"
            if col.data_type == TYPE_BOOLEAN:
                return "INTEGER"
            return "TEXT"

        if self.kind == DIALECT_POSTGRES:
            if col.data_type == TYPE_INTEGER:
                return "INTEGER"
            if col.data_type == TYPE_REAL:
                return "DOUBLE PRECISION"
            if col.data_type == TYPE_BOOLEAN:
                return "BOOLEAN"
            return "TEXT"

        if self.kind == DIALECT_MYSQL:
            if col.data_type == TYPE_INTEGER:
                return "INT"
            if col.data_type == TYPE_REAL:
                return "DOUBLE"
            if col.data_type == TYPE_BOOLEAN:
                return "TINYINT(1)"
            return "TEXT"

        raise DialectError("unknown dialect kind: " + str(self.kind))

    def column_type_sql(self: Dialect, col: Column) -> str:

        if self.kind == DIALECT_SQLITE:
            if col.data_type == TYPE_INTEGER and col.is_primary_key:
                if col.is_auto_increment:
                    return "INTEGER PRIMARY KEY AUTOINCREMENT"
                return "INTEGER PRIMARY KEY"
            return self.column_base_type_sql(col)

        if self.kind == DIALECT_POSTGRES:
            if col.data_type == TYPE_INTEGER and col.is_primary_key:
                if col.is_auto_increment:
                    return "SERIAL PRIMARY KEY"
                return "INTEGER PRIMARY KEY"
            return self.column_base_type_sql(col)

        if self.kind == DIALECT_MYSQL:
            if col.data_type == TYPE_INTEGER and col.is_primary_key:
                if col.is_auto_increment:
                    return "INT AUTO_INCREMENT PRIMARY KEY"
                return "INT PRIMARY KEY"
            return self.column_base_type_sql(col)

        raise DialectError("unknown dialect kind: " + str(self.kind))

    def create_table_sql(self: Dialect, tbl: Table) -> str:

        q_table: str = self.quote_identifier(tbl.name)
        parts: list[str] = []
        is_comp: bool = tbl.is_composite_pk()
        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            q_col: str = self.quote_identifier(col.name)
            col_sql: str = ""
            if is_comp and col.is_primary_key:
                col_sql = q_col + " " + self.column_base_type_sql(col) + " NOT NULL"
                if col.is_unique:
                    col_sql = col_sql + " UNIQUE"
            else:
                col_sql = q_col + " " + self.column_type_sql(col)
                if not col.is_primary_key:
                    if not col.is_nullable:
                        col_sql = col_sql + " NOT NULL"
                    if col.is_unique:
                        col_sql = col_sql + " UNIQUE"
            parts.append(col_sql)
            i = i + 1

        if is_comp:
            pks_quoted: list[str] = []
            p_i: int = 0
            while p_i < len(tbl.primary_keys):
                pks_quoted.append(self.quote_identifier(tbl.primary_keys[p_i]))
                p_i = p_i + 1
            parts.append("PRIMARY KEY (" + nox.strings.join(pks_quoted, ", ") + ")")

        body: str = nox.strings.join(parts, ", ")
        return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + body + ")"

    def drop_table_sql(self: Dialect, tbl: Table) -> str:

        return "DROP TABLE IF EXISTS " + self.quote_identifier(tbl.name)

    def upsert_sql(self: Dialect, tbl: Table, insert_cols: list[str], conflict_target: list[str], update_cols: list[str]) -> str:

        q_table: str = self.quote_identifier(tbl.name)
        quoted_ins: list[str] = []
        ins_placeholders: list[str] = []
        param_count: int = 0

        i: int = 0
        while i < len(insert_cols):
            quoted_ins.append(self.quote_identifier(insert_cols[i]))
            ins_placeholders.append(self.placeholder(param_count))
            param_count = param_count + 1
            i = i + 1

        sql: str = "INSERT INTO " + q_table + " (" + nox.strings.join(quoted_ins, ", ") + ") VALUES (" + nox.strings.join(ins_placeholders, ", ") + ")"

        if self.kind == DIALECT_SQLITE or self.kind == DIALECT_POSTGRES:
            quoted_targets: list[str] = []
            j: int = 0
            while j < len(conflict_target):
                quoted_targets.append(self.quote_identifier(conflict_target[j]))
                j = j + 1
            sql = sql + " ON CONFLICT (" + nox.strings.join(quoted_targets, ", ") + ")"
            if len(update_cols) == 0:
                sql = sql + " DO NOTHING"
            else:
                set_parts: list[str] = []
                k: int = 0
                while k < len(update_cols):
                    q_u: str = self.quote_identifier(update_cols[k])
                    ph: str = self.placeholder(param_count)
                    set_parts.append(q_u + " = " + ph)
                    param_count = param_count + 1
                    k = k + 1
                sql = sql + " DO UPDATE SET " + nox.strings.join(set_parts, ", ")

        elif self.kind == DIALECT_MYSQL:
            if len(update_cols) == 0:
                pk: str = "id"
                if tbl.primary_key != "":
                    pk = tbl.primary_key
                q_pk: str = self.quote_identifier(pk)
                sql = sql + " ON DUPLICATE KEY UPDATE " + q_pk + " = " + q_pk
            else:
                set_parts2: list[str] = []
                k2: int = 0
                while k2 < len(update_cols):
                    q_u2: str = self.quote_identifier(update_cols[k2])
                    ph2: str = self.placeholder(param_count)
                    set_parts2.append(q_u2 + " = " + ph2)
                    param_count = param_count + 1
                    k2 = k2 + 1
                sql = sql + " ON DUPLICATE KEY UPDATE " + nox.strings.join(set_parts2, ", ")

        return sql

    def migration_table_sql(self: Dialect) -> str:

        q_table: str = self.quote_identifier("_feather_migrations")
        q_id: str = self.quote_identifier("id")
        q_ver: str = self.quote_identifier("version")
        q_name: str = self.quote_identifier("name")
        q_check: str = self.quote_identifier("checksum")
        q_time: str = self.quote_identifier("applied_at")

        if self.kind == DIALECT_SQLITE:
            return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " INTEGER PRIMARY KEY AUTOINCREMENT, " + q_ver + " INTEGER NOT NULL UNIQUE, " + q_name + " TEXT NOT NULL, " + q_check + " TEXT NOT NULL, " + q_time + " TEXT NOT NULL)"

        if self.kind == DIALECT_POSTGRES:
            return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " SERIAL PRIMARY KEY, " + q_ver + " INTEGER NOT NULL UNIQUE, " + q_name + " TEXT NOT NULL, " + q_check + " TEXT NOT NULL, " + q_time + " TEXT NOT NULL)"

        if self.kind == DIALECT_MYSQL:
            return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " INT AUTO_INCREMENT PRIMARY KEY, " + q_ver + " INT NOT NULL UNIQUE, " + q_name + " TEXT NOT NULL, " + q_check + " TEXT NOT NULL, " + q_time + " TEXT NOT NULL)"

        raise DialectError("unknown dialect kind: " + str(self.kind))

    def migration_lock_table_sql(self: Dialect) -> str:

        q_table: str = self.quote_identifier("_feather_migration_lock")
        q_id: str = self.quote_identifier("id")
        q_locked: str = self.quote_identifier("is_locked")
        q_time: str = self.quote_identifier("locked_at")
        q_by: str = self.quote_identifier("locked_by")

        if self.kind == DIALECT_SQLITE or self.kind == DIALECT_POSTGRES:
            return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " INTEGER PRIMARY KEY, " + q_locked + " INTEGER NOT NULL, " + q_time + " TEXT NOT NULL, " + q_by + " TEXT NOT NULL)"
        if self.kind == DIALECT_MYSQL:
            return "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " INT PRIMARY KEY, " + q_locked + " INT NOT NULL, " + q_time + " TEXT NOT NULL, " + q_by + " TEXT NOT NULL)"
        raise DialectError("unknown dialect kind: " + str(self.kind))

    def boolean_sql(self: Dialect, b: bool) -> str:

        if self.kind == DIALECT_POSTGRES:
            if b:
                return "TRUE"
            return "FALSE"
        if b:
            return "1"
        return "0"

    def limit_offset_sql(self: Dialect, limit: int, offset: int) -> str:

        sql: str = ""
        if limit >= 0:
            sql = " LIMIT " + str(limit)
        if offset >= 0:
            if limit < 0 and self.kind == DIALECT_SQLITE:
                sql = " LIMIT -1 OFFSET " + str(offset)
            else:
                sql = sql + " OFFSET " + str(offset)
        return sql

    def supports_returning(self: Dialect) -> bool:

        return self.kind == DIALECT_POSTGRES

    def supports_transactional_ddl(self: Dialect) -> bool:

        if self.kind == DIALECT_MYSQL:
            return False
        return True

def sqlite_dialect() -> Dialect:
    return Dialect(DIALECT_SQLITE, "sqlite")

def postgres_dialect() -> Dialect:
    return Dialect(DIALECT_POSTGRES, "postgres")

def mysql_dialect() -> Dialect:
    return Dialect(DIALECT_MYSQL, "mysql")

def get_dialect(kind: int) -> Dialect:
    if kind == DIALECT_SQLITE:
        return sqlite_dialect()
    if kind == DIALECT_POSTGRES:
        return postgres_dialect()
    if kind == DIALECT_MYSQL:
        return mysql_dialect()
    raise DialectError("unsupported dialect kind: " + str(kind))
