# migrations.nox — Schema migration manager, version tracking, transactional execution, and concurrency control.

import session
from session import Session
import transaction
from transaction import Transaction, begin_transaction
import value
from value import Value, val_int, val_str
import errors
from errors import MigrationError
import nox.db
from nox.db import Row

import nox.crypto
import nox.random
import nox.time
import nox.strings
import dialects
from dialects import DIALECT_SQLITE, DIALECT_POSTGRES, DIALECT_MYSQL

def _current_timestamp() -> int:
    t: nox.time.DateTime = nox.time.now()
    days: int = (t.year - 2020) * 365 + (t.month * 31) + t.day
    return (days * 86400) + (t.hour * 3600) + (t.minute * 60) + t.second

def generate_lock_token() -> str:
    r1: int = nox.random.randint(100000000, 999999999)
    r2: int = nox.random.randint(100000000, 999999999)
    r3: int = nox.random.randint(100000000, 999999999)
    t: nox.time.DateTime = nox.time.now()
    seed: str = str(t.year) + str(t.month) + str(t.day) + str(t.hour) + str(t.minute) + str(t.second) + ":" + str(r1) + ":" + str(r2) + ":" + str(r3)
    raw: str = nox.crypto.sha256(seed)
    return raw[0:8] + "-" + raw[8:12] + "-4" + raw[13:16] + "-a" + raw[17:20] + "-" + raw[20:32]

def _is_table_not_found_error(err_msg: str) -> bool:
    msg: str = nox.strings.lower(err_msg)
    if "no such table" in msg:
        return True
    if "does not exist" in msg:
        return True
    if "doesn't exist" in msg:
        return True
    if "table not found" in msg:
        return True
    return False

def compute_migration_checksum(m: Migration) -> str:
    combined: str = str(m.version) + ":" + m.name + ":UP:"
    i: int = 0
    while i < len(m.up_sqls):
        combined = combined + m.up_sqls[i] + ";"
        i = i + 1
    combined = combined + ":DOWN:"
    j: int = 0
    while j < len(m.down_sqls):
        combined = combined + m.down_sqls[j] + ";"
        j = j + 1
    return nox.crypto.sha256(combined)

def _int_to_hex(n: int) -> str:
    if n == 0:
        return "00000000"
    val: int = n
    if val < 0:
        val = -val
    chars: list[str] = []
    hex_digits: str = "0123456789abcdef"
    while val > 0:
        rem: int = val % 16
        chars.append(hex_digits[rem])
        val = val // 16
    while len(chars) < 8:
        chars.append("0")
    res: str = ""
    idx: int = len(chars) - 1
    while idx >= 0:
        res = res + chars[idx]
        idx = idx - 1
    return res

def compute_legacy_string_checksum(s: str) -> str:
    h: int = 5381
    i: int = 0
    while i < len(s):
        c: int = ord(s[i])
        h = ((h * 33) + c) % 2147483647
        i = i + 1
    return _int_to_hex(h)

def compute_legacy_migration_checksum(m: Migration) -> str:
    combined: str = m.name + ":"
    i: int = 0
    while i < len(m.up_sqls):
        combined = combined + m.up_sqls[i] + ";"
        i = i + 1
    return compute_legacy_string_checksum(combined)

class Migration:
    version: int
    name: str
    up_sqls: list[str]
    down_sqls: list[str]

    def __init__(self: Migration, version: int, name: str, up_sqls: list[str], down_sqls: list[str]) -> None:
        if version <= 0:
            raise MigrationError("migration version must be a positive integer: " + str(version))
        self.version = version
        self.name = name
        self.up_sqls = up_sqls
        self.down_sqls = down_sqls

    def get_checksum(self: Migration) -> str:
        return compute_migration_checksum(self)

def migration(version: int, name: str, up_sqls: list[str], down_sqls: list[str]) -> Migration:
    return Migration(version, name, up_sqls, down_sqls)

def _validate_and_sort_migrations(migs: list[Migration]) -> list[Migration]:
    res: list[Migration] = []
    i: int = 0
    while i < len(migs):
        m: Migration = migs[i]
        # Check for duplicates
        j: int = 0
        while j < len(res):
            if res[j].version == m.version:
                raise MigrationError("duplicate migration version detected: " + str(m.version) + " (" + m.name + ")")
            j = j + 1
        # Insertion sort by version ascending
        inserted: bool = False
        new_res: list[Migration] = []
        k: int = 0
        while k < len(res):
            if not inserted and m.version < res[k].version:
                new_res.append(m)
                inserted = True
            new_res.append(res[k])
            k = k + 1
        if not inserted:
            new_res.append(m)
        res = new_res
        i = i + 1
    return res

class MigrationManager:
    session: Session
    migrations: list[Migration]
    current_lock_token: str

    def __init__(self: MigrationManager, session: Session, migrations: list[Migration]) -> None:
        self.session = session
        self.migrations = _validate_and_sort_migrations(migrations)
        self.current_lock_token = ""

    def _ensure_metadata_columns(self: MigrationManager) -> None:
        empty_p: list[Value] = []

        # 1. Ensure owner_token in _feather_migration_lock
        needs_owner_token: bool = False
        try:
            self.session.query_raw("SELECT owner_token FROM _feather_migration_lock LIMIT 0", empty_p)
        except Exception as _e_tok:
            needs_owner_token = True

        if needs_owner_token:
            try:
                self.session.execute_raw("ALTER TABLE _feather_migration_lock ADD COLUMN owner_token TEXT NOT NULL DEFAULT ''", empty_p)
            except Exception as _alt1:
                pass

        # 2. Ensure timeout_at in _feather_migration_lock
        needs_timeout: bool = False
        try:
            self.session.query_raw("SELECT timeout_at FROM _feather_migration_lock LIMIT 0", empty_p)
        except Exception as _e_to:
            needs_timeout = True

        if needs_timeout:
            try:
                col_t: str = "INTEGER"
                if self.session.dialect.kind == DIALECT_MYSQL:
                    col_t = "INT"
                self.session.execute_raw("ALTER TABLE _feather_migration_lock ADD COLUMN timeout_at " + col_t + " NOT NULL DEFAULT 0", empty_p)
            except Exception as _alt2:
                pass

        # 3. Ensure status in _feather_migrations
        needs_status: bool = False
        try:
            self.session.query_raw("SELECT status FROM _feather_migrations LIMIT 0", empty_p)
        except Exception as _e_st:
            needs_status = True

        if needs_status:
            try:
                self.session.execute_raw("ALTER TABLE _feather_migrations ADD COLUMN status TEXT NOT NULL DEFAULT 'APPLIED'", empty_p)
            except Exception as _alt3:
                pass

    def init_table(self: MigrationManager) -> None:

        sql: str = self.session.dialect.migration_table_sql()
        empty_params: list[Value] = []
        self.session.execute_raw(sql, empty_params)

        lock_sql: str = self.session.dialect.migration_lock_table_sql()
        self.session.execute_raw(lock_sql, empty_params)

        self._ensure_metadata_columns()

        init_row_sql: str = self.session.dialect.init_migration_lock_row_sql()
        self.session.execute_raw(init_row_sql, empty_params)

    def verify_checksums(self: MigrationManager) -> None:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        q_check: str = self.session.dialect.quote_identifier("checksum")
        q_status: str = self.session.dialect.quote_identifier("status")
        sql: str = "SELECT " + q_ver + ", " + q_check + ", " + q_status + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
        empty_params: list[Value] = []
        rows: list[Row] = self.session.query_raw(sql, empty_params)

        upgrade_versions: list[int] = []
        upgrade_checksums: list[str] = []

        r_idx: int = 0
        while r_idx < len(rows):
            v: int = rows[r_idx].get_int(0)
            rec_sum: str = rows[r_idx].get_str(1)
            st: str = rows[r_idx].get_str(2)

            if st == "FAILED":
                raise MigrationError("migration " + str(v) + " is in FAILED state due to partial non-transactional execution: manual schema resolution or rollback required before proceeding")
            if st == "RUNNING":
                raise MigrationError("migration " + str(v) + " is in RUNNING state (in-flight or crashed non-transactional execution): manual inspection required")

            found_migration: bool = False
            m_idx: int = 0
            while m_idx < len(self.migrations):
                m: Migration = self.migrations[m_idx]
                if m.version == v:
                    found_migration = True
                    curr_sum: str = m.get_checksum()
                    if rec_sum != "" and rec_sum != curr_sum:
                        # Check for backwards compatibility with v0.2.0 (8-character DJB2 checksum)
                        if len(rec_sum) == 8:
                            legacy_sum: str = compute_legacy_migration_checksum(m)
                            if rec_sum == legacy_sum:
                                # Queue legacy checksum for atomic upgrade
                                upgrade_versions.append(m.version)
                                upgrade_checksums.append(curr_sum)
                            else:
                                raise MigrationError("migration checksum mismatch for version " + str(m.version) + " (" + m.name + "): recorded legacy checksum " + rec_sum + ", but code legacy checksum is " + legacy_sum)
                        else:
                            raise MigrationError("migration checksum mismatch for version " + str(m.version) + " (" + m.name + "): recorded checksum " + rec_sum + ", but code checksum is " + curr_sum)
                m_idx = m_idx + 1
            if not found_migration:
                raise MigrationError("unknown applied migration version in database: " + str(v) + " (migration missing from codebase)")
            r_idx = r_idx + 1

        # Phase 2: All checksums verified valid — apply queued legacy upgrades atomically in a single transaction
        if len(upgrade_versions) > 0:
            tx: Transaction = begin_transaction(self.session)
            try:
                u_idx: int = 0
                while u_idx < len(upgrade_versions):
                    update_sql: str = "UPDATE " + q_table + " SET " + q_check + " = " + self.session.dialect.placeholder(0) + " WHERE " + q_ver + " = " + self.session.dialect.placeholder(1)
                    up_params: list[Value] = [val_str(upgrade_checksums[u_idx]), val_int(upgrade_versions[u_idx])]
                    self.session.execute_raw(update_sql, up_params)
                    u_idx = u_idx + 1
                tx.commit()
            except Exception as e:
                tx.rollback()
                raise MigrationError("failed to atomically upgrade legacy checksums: " + e.message)

    def get_applied_versions(self: MigrationManager) -> list[int]:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        q_status: str = self.session.dialect.quote_identifier("status")
        sql: str = "SELECT " + q_ver + ", " + q_status + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
        empty_params: list[Value] = []
        rows: list[Row] = self.session.query_raw(sql, empty_params)
        versions: list[int] = []
        i: int = 0
        while i < len(rows):
            v: int = rows[i].get_int(0)
            st: str = rows[i].get_str(1)
            if st == "FAILED":
                raise MigrationError("migration " + str(v) + " is in FAILED state due to partial non-transactional execution: manual schema resolution or rollback required before proceeding")
            if st == "RUNNING":
                raise MigrationError("migration " + str(v) + " is in RUNNING state (in-flight or crashed non-transactional execution): manual inspection required")
            versions.append(v)
            i = i + 1
        return versions

    def is_applied(self: MigrationManager, version: int) -> bool:

        applied: list[int] = self.get_applied_versions()
        i: int = 0
        while i < len(applied):
            if applied[i] == version:
                return True
            i = i + 1
        return False

    def get_pending_migrations(self: MigrationManager) -> list[Migration]:

        applied: list[int] = self.get_applied_versions()
        pending: list[Migration] = []
        i: int = 0
        while i < len(self.migrations):
            m: Migration = self.migrations[i]
            is_app: bool = False
            j: int = 0
            while j < len(applied):
                if applied[j] == m.version:
                    is_app = True
                j = j + 1
            if not is_app:
                pending.append(m)
            i = i + 1
        return pending

    def acquire_lock(self: MigrationManager, locked_by: str = "", timeout_seconds: int = 300) -> str:

        self.init_table()

        # Engine advisory lock (PostgreSQL / MySQL)
        adv_sql: str = self.session.dialect.advisory_lock_sql("")
        if adv_sql != "":
            empty_adv: list[Value] = []
            adv_rows: list[Row] = self.session.query_raw(adv_sql, empty_adv)
            if len(adv_rows) > 0 and adv_rows[0].get_int(0) == 0:
                raise MigrationError("migration advisory lock is held by another database session")

        now_ts: int = _current_timestamp()
        timeout_at: int = now_ts + timeout_seconds

        token: str = generate_lock_token()
        worker_label: str = locked_by
        if worker_label == "":
            worker_label = "runner_" + str(self.session.lease_id)

        q_table: str = self.session.dialect.quote_identifier("_feather_migration_lock")
        q_id: str = self.session.dialect.quote_identifier("id")
        q_locked: str = self.session.dialect.quote_identifier("is_locked")
        q_time: str = self.session.dialect.quote_identifier("locked_at")
        q_by: str = self.session.dialect.quote_identifier("locked_by")
        q_token: str = self.session.dialect.quote_identifier("owner_token")
        q_timeout: str = self.session.dialect.quote_identifier("timeout_at")

        ph1: str = self.session.dialect.placeholder(0)
        ph2: str = self.session.dialect.placeholder(1)
        ph3: str = self.session.dialect.placeholder(2)
        ph4: str = self.session.dialect.placeholder(3)
        ph5: str = self.session.dialect.placeholder(4)

        up_sql: str = "UPDATE " + q_table + " SET " + q_locked + " = 1, " + q_time + " = " + ph1 + ", " + q_by + " = " + ph2 + ", " + q_token + " = " + ph3 + ", " + q_timeout + " = " + ph4 + " WHERE " + q_id + " = 1 AND (" + q_locked + " = 0 OR " + q_timeout + " < " + ph5 + ")"
        up_params: list[Value] = [val_str("now"), val_str(worker_label), val_str(token), val_int(timeout_at), val_int(now_ts)]
        affected: int = self.session.execute_raw(up_sql, up_params)

        if affected > 0:
            self.current_lock_token = token
            return token

        check_sql: str = "SELECT " + q_by + ", " + q_time + ", " + q_timeout + " FROM " + q_table + " WHERE " + q_id + " = 1"
        empty_p: list[Value] = []
        rows: list[Row] = self.session.query_raw(check_sql, empty_p)
        holder: str = "unknown"
        if len(rows) > 0:
            holder = rows[0].get_str(0)
        raise MigrationError("migration lock is already held by another process or application instance (locked_by: " + holder + ")")

    def refresh_lock(self: MigrationManager, owner_token: str = "", additional_seconds: int = 300) -> bool:

        token: str = owner_token
        if token == "":
            token = self.current_lock_token
        if token == "":
            return False

        now_ts: int = _current_timestamp()
        new_timeout: int = now_ts + additional_seconds

        q_table: str = self.session.dialect.quote_identifier("_feather_migration_lock")
        q_id: str = self.session.dialect.quote_identifier("id")
        q_locked: str = self.session.dialect.quote_identifier("is_locked")
        q_token: str = self.session.dialect.quote_identifier("owner_token")
        q_timeout: str = self.session.dialect.quote_identifier("timeout_at")

        ph1: str = self.session.dialect.placeholder(0)
        ph2: str = self.session.dialect.placeholder(1)

        ref_sql: str = "UPDATE " + q_table + " SET " + q_timeout + " = " + ph1 + " WHERE " + q_id + " = 1 AND " + q_token + " = " + ph2 + " AND " + q_locked + " = 1"
        ref_params: list[Value] = [val_int(new_timeout), val_str(token)]
        affected: int = self.session.execute_raw(ref_sql, ref_params)
        return (affected > 0)

    def release_lock(self: MigrationManager, owner_token: str = "") -> None:

        token: str = owner_token
        if token == "":
            token = self.current_lock_token
        if token == "":
            return

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migration_lock")
        q_id: str = self.session.dialect.quote_identifier("id")
        q_locked: str = self.session.dialect.quote_identifier("is_locked")
        q_by: str = self.session.dialect.quote_identifier("locked_by")
        q_token: str = self.session.dialect.quote_identifier("owner_token")
        q_timeout: str = self.session.dialect.quote_identifier("timeout_at")

        ph1: str = self.session.dialect.placeholder(0)
        rel_sql: str = "UPDATE " + q_table + " SET " + q_locked + " = 0, " + q_by + " = '', " + q_token + " = '', " + q_timeout + " = 0 WHERE " + q_id + " = 1 AND " + q_token + " = " + ph1
        rel_params: list[Value] = [val_str(token)]
        affected: int = self.session.execute_raw(rel_sql, rel_params)

        if affected == 0:
            check_sql: str = "SELECT " + q_locked + ", " + q_by + ", " + q_token + " FROM " + q_table + " WHERE " + q_id + " = 1"
            empty_p: list[Value] = []
            rows: list[Row] = self.session.query_raw(check_sql, empty_p)
            if len(rows) > 0:
                is_l: int = rows[0].get_int(0)
                holder: str = rows[0].get_str(1)
                active_tok: str = rows[0].get_str(2)
                if is_l == 1 and active_tok != token:
                    raise MigrationError("cannot release migration lock: lock ownership mismatch (requested token: '" + token + "', current holder: '" + holder + "')")

        adv_unlock: str = self.session.dialect.advisory_unlock_sql("")
        if adv_unlock != "":
            empty_unl: list[Value] = []
            try:
                self.session.query_raw(adv_unlock, empty_unl)
            except Exception as _ign_unl:
                pass

        self.current_lock_token = ""

    def preview_up(self: MigrationManager) -> list[str]:

        applied: list[int] = []
        try:
            q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
            q_ver: str = self.session.dialect.quote_identifier("version")
            q_check: str = self.session.dialect.quote_identifier("checksum")
            q_status: str = self.session.dialect.quote_identifier("status")
            sql: str = "SELECT " + q_ver + ", " + q_check + ", " + q_status + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
            empty_p: list[Value] = []
            rows: list[Row] = self.session.query_raw(sql, empty_p)
            r_idx: int = 0
            while r_idx < len(rows):
                v: int = rows[r_idx].get_int(0)
                rec_sum: str = rows[r_idx].get_str(1)
                st: str = rows[r_idx].get_str(2)
                if st == "FAILED":
                    raise MigrationError("migration " + str(v) + " is in FAILED state due to partial non-transactional execution: manual schema resolution or rollback required before proceeding")
                if st == "RUNNING":
                    raise MigrationError("migration " + str(v) + " is in RUNNING state (in-flight or crashed non-transactional execution): manual inspection required")

                found_m: bool = False
                m_idx: int = 0
                while m_idx < len(self.migrations):
                    m: Migration = self.migrations[m_idx]
                    if m.version == v:
                        found_m = True
                        curr_sum: str = m.get_checksum()
                        if rec_sum != "" and rec_sum != curr_sum:
                            if len(rec_sum) == 8 and rec_sum == compute_legacy_migration_checksum(m):
                                pass
                            else:
                                raise MigrationError("migration checksum mismatch for version " + str(m.version) + " (" + m.name + "): recorded checksum " + rec_sum + ", but code checksum is " + curr_sum)
                    m_idx = m_idx + 1
                if not found_m:
                    raise MigrationError("unknown applied migration version in database: " + str(v) + " (migration missing from codebase)")

                applied.append(v)
                r_idx = r_idx + 1
        except MigrationError as me:
            raise me
        except Exception as e:
            if _is_table_not_found_error(e.message):
                pass
            else:
                raise MigrationError("failed to inspect schema for preview: " + e.message)

        sqls: list[str] = []
        i: int = 0
        while i < len(self.migrations):
            m: Migration = self.migrations[i]
            is_app: bool = False
            j: int = 0
            while j < len(applied):
                if applied[j] == m.version:
                    is_app = True
                j = j + 1
            if not is_app:
                s_idx: int = 0
                while s_idx < len(m.up_sqls):
                    sqls.append(m.up_sqls[s_idx])
                    s_idx = s_idx + 1
            i = i + 1
        return sqls

    def preview_down(self: MigrationManager, target_version: int) -> list[str]:

        applied: list[int] = []
        try:
            q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
            q_ver: str = self.session.dialect.quote_identifier("version")
            q_check: str = self.session.dialect.quote_identifier("checksum")
            q_status: str = self.session.dialect.quote_identifier("status")
            sql: str = "SELECT " + q_ver + ", " + q_check + ", " + q_status + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
            empty_p: list[Value] = []
            rows: list[Row] = self.session.query_raw(sql, empty_p)
            r_idx: int = 0
            while r_idx < len(rows):
                v: int = rows[r_idx].get_int(0)
                st: str = rows[r_idx].get_str(2)
                if st == "FAILED":
                    raise MigrationError("migration " + str(v) + " is in FAILED state due to partial non-transactional execution: manual schema resolution or rollback required before proceeding")
                if st == "RUNNING":
                    raise MigrationError("migration " + str(v) + " is in RUNNING state (in-flight or crashed non-transactional execution): manual inspection required")
                applied.append(v)
                r_idx = r_idx + 1
        except MigrationError as me:
            raise me
        except Exception as e:
            if _is_table_not_found_error(e.message):
                pass
            else:
                raise MigrationError("failed to inspect schema for preview: " + e.message)

        sqls: list[str] = []
        idx: int = len(self.migrations) - 1
        while idx >= 0:
            m: Migration = self.migrations[idx]
            if m.version > target_version:
                is_app: bool = False
                j: int = 0
                while j < len(applied):
                    if applied[j] == m.version:
                        is_app = True
                    j = j + 1
                if is_app:
                    s_idx: int = 0
                    while s_idx < len(m.down_sqls):
                        sqls.append(m.down_sqls[s_idx])
                        s_idx = s_idx + 1
            idx = idx - 1
        return sqls

    def plan_up(self: MigrationManager) -> list[str]:
        return self.preview_up()

    def plan_down(self: MigrationManager, target_version: int) -> list[str]:
        return self.preview_down(target_version)

    def repair_migration_status(self: MigrationManager, version: int, new_status: str = "APPLIED") -> None:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        q_status: str = self.session.dialect.quote_identifier("status")
        ph1: str = self.session.dialect.placeholder(0)
        ph2: str = self.session.dialect.placeholder(1)
        upd_sql: str = "UPDATE " + q_table + " SET " + q_status + " = " + ph1 + " WHERE " + q_ver + " = " + ph2
        upd_params: list[Value] = [val_str(new_status), val_int(version)]
        self.session.execute_raw(upd_sql, upd_params)

    def drop_migration_record(self: MigrationManager, version: int) -> None:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        ph1: str = self.session.dialect.placeholder(0)
        del_sql: str = "DELETE FROM " + q_table + " WHERE " + q_ver + " = " + ph1
        del_params: list[Value] = [val_int(version)]
        self.session.execute_raw(del_sql, del_params)

    def migrate_up(self: MigrationManager) -> int:

        token: str = self.acquire_lock()
        try:
            self.init_table()
            self.verify_checksums()
            pending: list[Migration] = self.get_pending_migrations()
            count: int = 0
            has_tx_ddl: bool = self.session.dialect.supports_transactional_ddl()

            i: int = 0
            while i < len(pending):
                # Lease fencing / heartbeat check before each migration step
                if not self.refresh_lock(token, 300):
                    raise MigrationError("migration lease lost or reclaimed by another instance: aborting execution to prevent concurrent schema corruption")

                m: Migration = pending[i]
                if has_tx_ddl:
                    tx: Transaction = begin_transaction(self.session)
                    try:
                        s_idx: int = 0
                        while s_idx < len(m.up_sqls):
                            empty_p: list[Value] = []
                            self.session.execute_raw(m.up_sqls[s_idx], empty_p)
                            s_idx = s_idx + 1

                        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                        q_ver: str = self.session.dialect.quote_identifier("version")
                        q_name: str = self.session.dialect.quote_identifier("name")
                        q_check: str = self.session.dialect.quote_identifier("checksum")
                        q_time: str = self.session.dialect.quote_identifier("applied_at")
                        q_status: str = self.session.dialect.quote_identifier("status")

                        ph1: str = self.session.dialect.placeholder(0)
                        ph2: str = self.session.dialect.placeholder(1)
                        ph3: str = self.session.dialect.placeholder(2)
                        ph4: str = self.session.dialect.placeholder(3)
                        ph5: str = self.session.dialect.placeholder(4)

                        record_sql: str = "INSERT INTO " + q_table + " (" + q_ver + ", " + q_name + ", " + q_check + ", " + q_time + ", " + q_status + ") VALUES (" + ph1 + ", " + ph2 + ", " + ph3 + ", " + ph4 + ", " + ph5 + ")"
                        rec_params: list[Value] = [val_int(m.version), val_str(m.name), val_str(m.get_checksum()), val_str("now"), val_str("APPLIED")]
                        self.session.execute_raw(record_sql, rec_params)

                        tx.commit()
                        count = count + 1
                    except Exception as e:
                        tx.rollback()
                        raise MigrationError("failed applying migration " + str(m.version) + " (" + m.name + "): " + e.message)
                else:
                    # Non-transactional DDL engine (e.g. MySQL implicit commits)
                    q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                    q_ver: str = self.session.dialect.quote_identifier("version")
                    q_name: str = self.session.dialect.quote_identifier("name")
                    q_check: str = self.session.dialect.quote_identifier("checksum")
                    q_time: str = self.session.dialect.quote_identifier("applied_at")
                    q_status: str = self.session.dialect.quote_identifier("status")

                    ph1: str = self.session.dialect.placeholder(0)
                    ph2: str = self.session.dialect.placeholder(1)
                    ph3: str = self.session.dialect.placeholder(2)
                    ph4: str = self.session.dialect.placeholder(3)
                    ph5: str = self.session.dialect.placeholder(4)

                    running_sql: str = "INSERT INTO " + q_table + " (" + q_ver + ", " + q_name + ", " + q_check + ", " + q_time + ", " + q_status + ") VALUES (" + ph1 + ", " + ph2 + ", " + ph3 + ", " + ph4 + ", " + ph5 + ")"
                    run_params: list[Value] = [val_int(m.version), val_str(m.name), val_str(m.get_checksum()), val_str("now"), val_str("RUNNING")]
                    self.session.execute_raw(running_sql, run_params)

                    try:
                        s_idx: int = 0
                        while s_idx < len(m.up_sqls):
                            empty_p: list[Value] = []
                            self.session.execute_raw(m.up_sqls[s_idx], empty_p)
                            s_idx = s_idx + 1

                        upd_sql: str = "UPDATE " + q_table + " SET " + q_status + " = " + ph1 + " WHERE " + q_ver + " = " + ph2
                        self.session.execute_raw(upd_sql, [val_str("APPLIED"), val_int(m.version)])
                        count = count + 1
                    except Exception as e_non_tx:
                        fail_sql: str = "UPDATE " + q_table + " SET " + q_status + " = " + ph1 + " WHERE " + q_ver + " = " + ph2
                        try:
                            self.session.execute_raw(fail_sql, [val_str("FAILED"), val_int(m.version)])
                        except Exception as _ignored:
                            pass
                        raise MigrationError("failed applying non-transactional migration " + str(m.version) + " (" + m.name + "): DDL statements in " + self.session.dialect.name + " may have partially executed due to implicit commits: " + e_non_tx.message)
                i = i + 1

            self.release_lock(token)
            return count
        except Exception as e_outer:
            try:
                self.release_lock(token)
            except Exception as _ignored:
                pass
            raise e_outer

    def migrate_down(self: MigrationManager, target_version: int) -> int:

        token: str = self.acquire_lock()
        try:
            self.init_table()
            self.verify_checksums()
            applied: list[int] = self.get_applied_versions()
            count: int = 0
            has_tx_ddl: bool = self.session.dialect.supports_transactional_ddl()

            # Roll back from latest down to target_version
            idx: int = len(self.migrations) - 1
            while idx >= 0:
                m: Migration = self.migrations[idx]
                if m.version > target_version:
                    is_app: bool = False
                    j: int = 0
                    while j < len(applied):
                        if applied[j] == m.version:
                            is_app = True
                        j = j + 1

                    if is_app:
                        # Lease fencing / heartbeat check before each rollback step
                        if not self.refresh_lock(token, 300):
                            raise MigrationError("migration lease lost or reclaimed by another instance: aborting rollback to prevent concurrent schema corruption")

                        if has_tx_ddl:
                            tx: Transaction = begin_transaction(self.session)
                            try:
                                s_idx: int = 0
                                while s_idx < len(m.down_sqls):
                                    empty_p: list[Value] = []
                                    self.session.execute_raw(m.down_sqls[s_idx], empty_p)
                                    s_idx = s_idx + 1

                                q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                                q_ver: str = self.session.dialect.quote_identifier("version")
                                del_sql: str = "DELETE FROM " + q_table + " WHERE " + q_ver + " = " + self.session.dialect.placeholder(0)
                                del_params: list[Value] = [val_int(m.version)]
                                self.session.execute_raw(del_sql, del_params)

                                tx.commit()
                                count = count + 1
                            except Exception as e:
                                tx.rollback()
                                raise MigrationError("failed rolling back migration " + str(m.version) + ": " + e.message)
                        else:
                            # Non-transactional DDL (MySQL)
                            try:
                                s_idx: int = 0
                                while s_idx < len(m.down_sqls):
                                    empty_p: list[Value] = []
                                    self.session.execute_raw(m.down_sqls[s_idx], empty_p)
                                    s_idx = s_idx + 1

                                q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                                q_ver: str = self.session.dialect.quote_identifier("version")
                                del_sql: str = "DELETE FROM " + q_table + " WHERE " + q_ver + " = " + self.session.dialect.placeholder(0)
                                del_params: list[Value] = [val_int(m.version)]
                                self.session.execute_raw(del_sql, del_params)
                                count = count + 1
                            except Exception as e_non_tx:
                                raise MigrationError("failed rolling back non-transactional migration " + str(m.version) + ": DDL statements in " + self.session.dialect.name + " may have partially executed: " + e_non_tx.message)
                idx = idx - 1

            self.release_lock(token)
            return count
        except Exception as e_outer:
            try:
                self.release_lock(token)
            except Exception as _ignored:
                pass
            raise e_outer

    def status(self: MigrationManager) -> list[str]:

        self.init_table()
        applied: list[int] = self.get_applied_versions()
        lines: list[str] = []

        i: int = 0
        while i < len(self.migrations):
            m: Migration = self.migrations[i]
            is_app: bool = False
            j: int = 0
            while j < len(applied):
                if applied[j] == m.version:
                    is_app = True
                j = j + 1

            status_mark: str = "[ ]"
            status_text: str = "pending"
            if is_app:
                status_mark = "[x]"
                status_text = "applied"

            lines.append(status_mark + " " + str(m.version) + " - " + m.name + " (" + status_text + ")")
            i = i + 1

        return lines
