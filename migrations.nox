# migrations.nox — Schema migration manager, version tracking, and transactional execution.

import session
from session import Session
import transaction
from transaction import Transaction, begin_transaction
import value
from value import Value, val_int, val_str
import errors
from errors import MigrationError
import nox.db
from nox.db import Row

def _int_to_hex(n: int) -> str:
    if n == 0:
        return "00000000"
    val: int = n
    if val < 0:
        val = -val
    chars: list[str] = []
    hex_digits: str = "0123456789abcdef"
    while val > 0:
        rem: int = val % 16
        chars.append(hex_digits[rem])
        val = val // 16
    while len(chars) < 8:
        chars.append("0")
    res: str = ""
    idx: int = len(chars) - 1
    while idx >= 0:
        res = res + chars[idx]
        idx = idx - 1
    return res

def compute_string_checksum(s: str) -> str:
    h: int = 5381
    i: int = 0
    while i < len(s):
        c: int = ord(s[i])
        h = ((h * 33) + c) % 2147483647
        i = i + 1
    return _int_to_hex(h)

def compute_migration_checksum(m: Migration) -> str:
    combined: str = m.name + ":"
    i: int = 0
    while i < len(m.up_sqls):
        combined = combined + m.up_sqls[i] + ";"
        i = i + 1
    return compute_string_checksum(combined)

class Migration:
    version: int
    name: str
    up_sqls: list[str]
    down_sqls: list[str]

    def __init__(self: Migration, version: int, name: str, up_sqls: list[str], down_sqls: list[str]) -> None:
        if version <= 0:
            raise MigrationError("migration version must be a positive integer: " + str(version))
        self.version = version
        self.name = name
        self.up_sqls = up_sqls
        self.down_sqls = down_sqls

    def get_checksum(self: Migration) -> str:
        return compute_migration_checksum(self)

def migration(version: int, name: str, up_sqls: list[str], down_sqls: list[str]) -> Migration:
    return Migration(version, name, up_sqls, down_sqls)

class MigrationManager:
    session: Session
    migrations: list[Migration]

    def __init__(self: MigrationManager, session: Session, migrations: list[Migration]) -> None:
        self.session = session
        self.migrations = migrations

    def init_table(self: MigrationManager) -> None:

        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_id: str = self.session.dialect.quote_identifier("id")
        q_ver: str = self.session.dialect.quote_identifier("version")
        q_name: str = self.session.dialect.quote_identifier("name")
        q_check: str = self.session.dialect.quote_identifier("checksum")
        q_time: str = self.session.dialect.quote_identifier("applied_at")

        pk_col: str = "INTEGER PRIMARY KEY AUTOINCREMENT"
        if self.session.dialect.supports_returning():
            pk_col = "SERIAL PRIMARY KEY"

        sql: str = "CREATE TABLE IF NOT EXISTS " + q_table + " (" + q_id + " " + pk_col + ", " + q_ver + " INTEGER NOT NULL UNIQUE, " + q_name + " TEXT NOT NULL, " + q_check + " TEXT NOT NULL, " + q_time + " TEXT NOT NULL)"
        empty_params: list[Value] = []
        self.session.execute_raw(sql, empty_params)

    def verify_checksums(self: MigrationManager) -> None:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        q_check: str = self.session.dialect.quote_identifier("checksum")
        sql: str = "SELECT " + q_ver + ", " + q_check + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
        empty_params: list[Value] = []
        rows: list[Row] = self.session.query_raw(sql, empty_params)

        r_idx: int = 0
        while r_idx < len(rows):
            v: int = rows[r_idx].get_int(0)
            rec_sum: str = rows[r_idx].get_str(1)
            m_idx: int = 0
            while m_idx < len(self.migrations):
                m: Migration = self.migrations[m_idx]
                if m.version == v:
                    curr_sum: str = m.get_checksum()
                    if rec_sum != "" and rec_sum != curr_sum:
                        raise MigrationError("migration checksum mismatch for version " + str(m.version) + " (" + m.name + "): recorded checksum " + rec_sum + ", but code checksum is " + curr_sum)
                m_idx = m_idx + 1
            r_idx = r_idx + 1

    def get_applied_versions(self: MigrationManager) -> list[int]:

        self.init_table()
        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
        q_ver: str = self.session.dialect.quote_identifier("version")
        sql: str = "SELECT " + q_ver + " FROM " + q_table + " ORDER BY " + q_ver + " ASC"
        empty_params: list[Value] = []
        rows: list[Row] = self.session.query_raw(sql, empty_params)
        versions: list[int] = []
        i: int = 0
        while i < len(rows):
            versions.append(rows[i].get_int(0))
            i = i + 1
        return versions

    def is_applied(self: MigrationManager, version: int) -> bool:

        applied: list[int] = self.get_applied_versions()
        i: int = 0
        while i < len(applied):
            if applied[i] == version:
                return True
            i = i + 1
        return False

    def get_pending_migrations(self: MigrationManager) -> list[Migration]:

        applied: list[int] = self.get_applied_versions()
        pending: list[Migration] = []
        i: int = 0
        while i < len(self.migrations):
            m: Migration = self.migrations[i]
            is_app: bool = False
            j: int = 0
            while j < len(applied):
                if applied[j] == m.version:
                    is_app = True
                j = j + 1
            if not is_app:
                pending.append(m)
            i = i + 1
        return pending

    def migrate_up(self: MigrationManager) -> int:

        self.init_table()
        self.verify_checksums()
        pending: list[Migration] = self.get_pending_migrations()
        count: int = 0

        i: int = 0
        while i < len(pending):
            m: Migration = pending[i]
            tx: Transaction = begin_transaction(self.session)
            try:
                # Execute each UP SQL statement
                s_idx: int = 0
                while s_idx < len(m.up_sqls):
                    empty_p: list[Value] = []
                    self.session.execute_raw(m.up_sqls[s_idx], empty_p)
                    s_idx = s_idx + 1

                # Record migration in tracking table
                q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                q_ver: str = self.session.dialect.quote_identifier("version")
                q_name: str = self.session.dialect.quote_identifier("name")
                q_check: str = self.session.dialect.quote_identifier("checksum")
                q_time: str = self.session.dialect.quote_identifier("applied_at")

                ph1: str = self.session.dialect.placeholder(0)
                ph2: str = self.session.dialect.placeholder(1)
                ph3: str = self.session.dialect.placeholder(2)
                ph4: str = self.session.dialect.placeholder(3)

                record_sql: str = "INSERT INTO " + q_table + " (" + q_ver + ", " + q_name + ", " + q_check + ", " + q_time + ") VALUES (" + ph1 + ", " + ph2 + ", " + ph3 + ", " + ph4 + ")"
                rec_params: list[Value] = [val_int(m.version), val_str(m.name), val_str(m.get_checksum()), val_str("now")]
                self.session.execute_raw(record_sql, rec_params)

                tx.commit()
                count = count + 1
            except Exception as e:
                tx.rollback()
                raise MigrationError("failed applying migration " + str(m.version) + " (" + m.name + "): " + e.message)
            i = i + 1

        return count

    def migrate_down(self: MigrationManager, target_version: int) -> int:

        self.init_table()
        applied: list[int] = self.get_applied_versions()
        count: int = 0

        # Roll back from latest down to target_version
        idx: int = len(self.migrations) - 1
        while idx >= 0:
            m: Migration = self.migrations[idx]
            if m.version > target_version:
                is_app: bool = False
                j: int = 0
                while j < len(applied):
                    if applied[j] == m.version:
                        is_app = True
                    j = j + 1

                if is_app:
                    tx: Transaction = begin_transaction(self.session)
                    try:
                        s_idx: int = 0
                        while s_idx < len(m.down_sqls):
                            empty_p: list[Value] = []
                            self.session.execute_raw(m.down_sqls[s_idx], empty_p)
                            s_idx = s_idx + 1

                        q_table: str = self.session.dialect.quote_identifier("_feather_migrations")
                        q_ver: str = self.session.dialect.quote_identifier("version")
                        del_sql: str = "DELETE FROM " + q_table + " WHERE " + q_ver + " = " + self.session.dialect.placeholder(0)
                        del_params: list[Value] = [val_int(m.version)]
                        self.session.execute_raw(del_sql, del_params)

                        tx.commit()
                        count = count + 1
                    except Exception as e:
                        tx.rollback()
                        raise MigrationError("failed rolling back migration " + str(m.version) + ": " + e.message)
            idx = idx - 1

        return count

    def status(self: MigrationManager) -> list[str]:

        self.init_table()
        applied: list[int] = self.get_applied_versions()
        lines: list[str] = []

        i: int = 0
        while i < len(self.migrations):
            m: Migration = self.migrations[i]
            is_app: bool = False
            j: int = 0
            while j < len(applied):
                if applied[j] == m.version:
                    is_app = True
                j = j + 1

            status_mark: str = "[ ]"
            status_text: str = "pending"
            if is_app:
                status_mark = "[x]"
                status_text = "applied"

            lines.append(status_mark + " " + str(m.version) + " - " + m.name + " (" + status_text + ")")
            i = i + 1

        return lines
