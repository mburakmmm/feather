# pool.nox — Lightweight, bounded connection pool for Feather.

import dialects
from dialects import Dialect, sqlite_dialect
import session
from session import Session, FeatherConn, wrap_db_connection
import errors
from errors import PoolError
import nox.sqlite

class PoolConfig:
    max_connections: int
    factory: () -> FeatherConn
    dialect: Dialect

    def __init__(self: PoolConfig, max_connections: int, factory: () -> FeatherConn, dialect: Dialect) -> None:
        if max_connections <= 0:
            raise PoolError("max_connections must be greater than zero")
        self.max_connections = max_connections
        self.factory = factory
        self.dialect = dialect

class ConnectionPool:
    config: PoolConfig
    idle_conns: list[FeatherConn]
    active_count: int
    is_closed: bool

    def __init__(self: ConnectionPool, config: PoolConfig) -> None:
        self.config = config
        self.idle_conns = []
        self.active_count = 0
        self.is_closed = False

    def acquire(self: ConnectionPool) -> Session:

        if self.is_closed:
            raise PoolError("cannot acquire connection from a closed pool")

        conn: FeatherConn | None = None
        if len(self.idle_conns) > 0:
            last_idx: int = len(self.idle_conns) - 1
            conn = self.idle_conns[last_idx]
            new_idles: list[FeatherConn] = []
            i: int = 0
            while i < last_idx:
                new_idles.append(self.idle_conns[i])
                i = i + 1
            self.idle_conns = new_idles
            self.active_count = self.active_count + 1
        elif self.active_count < self.config.max_connections:
            f: () -> FeatherConn = self.config.factory
            conn = f()
            self.active_count = self.active_count + 1
        else:
            raise PoolError("connection pool exhausted: active connections reached limit of " + str(self.config.max_connections))

        if conn is None:
            raise PoolError("failed to create or acquire connection")

        fc: FeatherConn = conn
        # Session wraps the pooled connection without closing the underlying handle when session closes
        return Session(fc, self.config.dialect, False)

    def release_connection(self: ConnectionPool, s: Session) -> None:

        if self.active_count > 0:
            self.active_count = self.active_count - 1

        if self.is_closed:
            s.conn.close()
            return

        idles: list[FeatherConn] = self.idle_conns
        idles.append(s.conn)
        self.idle_conns = idles

    def idle_count(self: ConnectionPool) -> int:

        return len(self.idle_conns)

    def in_use_count(self: ConnectionPool) -> int:

        return self.active_count

    def close_all(self: ConnectionPool) -> None:

        self.is_closed = True
        i: int = 0
        while i < len(self.idle_conns):
            self.idle_conns[i].close()
            i = i + 1
        self.idle_conns = []
        self.active_count = 0

def create_pool(factory: () -> FeatherConn, dialect: Dialect, max_connections: int = 10) -> ConnectionPool:
    cfg: PoolConfig = PoolConfig(max_connections, factory, dialect)
    return ConnectionPool(cfg)

def create_sqlite_pool(db_path: str, max_connections: int = 10) -> ConnectionPool:
    def _sqlite_factory() -> FeatherConn:
        conn: nox.sqlite.Connection = nox.sqlite.open(db_path)
        return wrap_db_connection(conn)
    return create_pool(_sqlite_factory, sqlite_dialect(), max_connections)
