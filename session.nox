# session.nox — Unit of work, database connection wrapper, transaction context, streaming, and CRUD operations for Feather.

import nox.db
from nox.db import DbConnection, Row, Statement
import nox.postgres
from nox.postgres import PostgresError
import nox.strings
import nox.time
import nox.path
from nox.path import PathError
import metadata
from metadata import Table, Column, TYPE_INTEGER, assert_valid_identifier
import value
from value import Value, val_int, val_str, val_float, val_bool, val_null, bind_value
import dialects
from dialects import Dialect, DIALECT_SQLITE, DIALECT_POSTGRES, DIALECT_MYSQL
import query
from query import SelectQuery, WhereClause, Predicate, CompiledQuery, ParamCollector, eq, gt, select, select_all, compile_where_clause, OP_IS_NULL, OP_IS_NOT_NULL, OP_IN, OP_NEQ, OP_GT, OP_GTE, OP_LT, OP_LTE, OP_LIKE, LOGIC_OR, ORDER_ASC
import mapper
from mapper import Model
import errors
from errors import ConnectionError, QueryBuildError, TransactionError, FeatherError, classify_driver_error, from_postgres_error, is_retryable_message

TX_STATE_IDLE: int = 0
TX_STATE_ACTIVE: int = 1
TX_STATE_COMMITTED: int = 2
TX_STATE_ROLLED_BACK: int = 3
TX_STATE_FAILED: int = 4

def _default_is_ok() -> bool:
    return True

def _default_set_timeout(ms: int) -> None:
    pass

def _default_cancel() -> bool:
    return False

class FeatherConn:
    prepare_fn: (str) -> Statement
    execute_fn: (str) -> int
    query_fn: (str) -> list[Row]
    close_fn: () -> None
    is_ok_fn: () -> bool
    set_query_timeout_fn: (int) -> None
    set_statement_timeout_fn: (int) -> None
    set_lock_timeout_fn: (int) -> None
    cancel_fn: () -> bool

    def __init__(self, prepare_fn: (str) -> Statement, execute_fn: (str) -> int, query_fn: (str) -> list[Row], close_fn: () -> None) -> None:
        self.prepare_fn = prepare_fn
        self.execute_fn = execute_fn
        self.query_fn = query_fn
        self.close_fn = close_fn
        self.is_ok_fn = _default_is_ok
        self.set_query_timeout_fn = _default_set_timeout
        self.set_statement_timeout_fn = _default_set_timeout
        self.set_lock_timeout_fn = _default_set_timeout
        self.cancel_fn = _default_cancel

    def prepare(self, sql: str) -> Statement:
        f: (str) -> Statement = self.prepare_fn
        return f(sql)

    def execute(self, sql: str) -> int:
        f: (str) -> int = self.execute_fn
        return f(sql)

    def query(self, sql: str) -> list[Row]:
        f: (str) -> list[Row] = self.query_fn
        return f(sql)

    def close(self) -> None:
        f: () -> None = self.close_fn
        f()

    def is_ok(self) -> bool:
        f: () -> bool = self.is_ok_fn
        return f()

    def set_query_timeout(self, ms: int) -> None:
        f: (int) -> None = self.set_query_timeout_fn
        f(ms)

    def set_statement_timeout(self, ms: int) -> None:
        f: (int) -> None = self.set_statement_timeout_fn
        f(ms)

    def set_lock_timeout(self, ms: int) -> None:
        f: (int) -> None = self.set_lock_timeout_fn
        f(ms)

    def cancel(self) -> bool:
        f: () -> bool = self.cancel_fn
        return f()

def wrap_db_connection(conn: DbConnection) -> FeatherConn:
    def _prep(sql: str) -> Statement:
        return conn.prepare(sql)
    def _exec(sql: str) -> int:
        return conn.execute(sql)
    def _query(sql: str) -> list[Row]:
        return conn.query(sql)
    def _close() -> None:
        conn.close()
    return FeatherConn(_prep, _exec, _query, _close)

def wrap_postgres_connection(conn: nox.postgres.Connection) -> FeatherConn:
    fc: FeatherConn = wrap_db_connection(conn)
    def _is_ok() -> bool:
        return conn.is_ok()
    def _q_timeout(ms: int) -> None:
        conn.set_query_timeout(ms)
    def _s_timeout(ms: int) -> None:
        conn.set_statement_timeout(ms)
    def _l_timeout(ms: int) -> None:
        conn.set_lock_timeout(ms)
    def _cancel() -> bool:
        return conn.cancel()
    fc.is_ok_fn = _is_ok
    fc.set_query_timeout_fn = _q_timeout
    fc.set_statement_timeout_fn = _s_timeout
    fc.set_lock_timeout_fn = _l_timeout
    fc.cancel_fn = _cancel
    return fc

def _extract_sql_tokens(sql: str) -> list[str]:
    tokens: list[str] = []
    curr: str = ""
    i: int = 0
    while i < len(sql):
        c: str = sql[i]
        if c == " " or c == "\t" or c == "\n" or c == "\r" or c == ";":
            if len(curr) > 0:
                tokens.append(curr)
                curr = ""
        else:
            curr = curr + c
        i = i + 1
    if len(curr) > 0:
        tokens.append(curr)
    return tokens

class Transaction:
    session: Session
    state: int

    def __init__(self: Transaction, session: Session) -> None:
        self.session = session
        self.state = TX_STATE_IDLE

    def is_active(self: Transaction) -> bool:
        return self.state == TX_STATE_ACTIVE

    def begin(self: Transaction) -> None:
        if self.state != TX_STATE_IDLE:
            raise TransactionError("cannot begin transaction: current state is not IDLE (state=" + str(self.state) + ")")

        begin_sql: str = "BEGIN"
        if self.session.dialect.kind == DIALECT_MYSQL:
            begin_sql = "START TRANSACTION"

        empty_params: list[Value] = []
        try:
            self.session.execute_raw(begin_sql, empty_params)
            self.state = TX_STATE_ACTIVE
            self.session.in_transaction = True
        except Exception as e:
            self.state = TX_STATE_FAILED
            self.session.in_transaction = False
            raise TransactionError("failed to begin transaction: " + e.message) from e

    def commit(self: Transaction) -> None:
        if self.state != TX_STATE_ACTIVE:
            raise TransactionError("cannot commit transaction: transaction is not active (state=" + str(self.state) + ")")

        empty_params: list[Value] = []
        try:
            self.session.execute_raw("COMMIT", empty_params)
            self.state = TX_STATE_COMMITTED
            self.session.in_transaction = False
        except Exception as e:
            self.state = TX_STATE_FAILED
            self.session.in_transaction = True
            self.session.is_poisoned = True
            raise TransactionError("failed to commit transaction: " + e.message) from e

    def rollback(self: Transaction) -> None:
        if self.state != TX_STATE_ACTIVE and self.state != TX_STATE_FAILED:
            raise TransactionError("cannot rollback transaction: transaction is not active or failed (state=" + str(self.state) + ")")

        empty_params: list[Value] = []
        try:
            self.session.execute_raw("ROLLBACK", empty_params)
            self.state = TX_STATE_ROLLED_BACK
            self.session.in_transaction = False
        except Exception as e:
            self.state = TX_STATE_FAILED
            self.session.in_transaction = True
            self.session.is_poisoned = True
            raise TransactionError("failed to rollback transaction: " + e.message) from e

    def execute(self: Transaction, sql: str, params: list[Value]) -> int:
        return self.session.execute_raw(sql, params)

    def query(self: Transaction, sql: str, params: list[Value]) -> list[Row]:
        return self.session.query_raw(sql, params)

    def __enter__(self: Transaction) -> Transaction:
        if self.state == TX_STATE_IDLE:
            self.begin()
        return self

    def __exit__(self: Transaction) -> None:
        if self.state == TX_STATE_ACTIVE or self.state == TX_STATE_FAILED:
            try:
                self.rollback()
            except Exception as e_rb:
                self.session.is_poisoned = True

class Session:
    conn: FeatherConn
    dialect: Dialect
    owns_conn: bool
    is_closed: bool
    pool_id: int
    lease_id: int
    is_released: bool
    in_transaction: bool
    is_poisoned: bool

    def __init__(self, conn: FeatherConn, dialect: Dialect, owns_conn: bool = True, pool_id: int = 0, lease_id: int = 0) -> None:
        self.conn = conn
        self.dialect = dialect
        self.owns_conn = owns_conn
        self.is_closed = False
        self.pool_id = pool_id
        self.lease_id = lease_id
        self.is_released = False
        self.in_transaction = False
        self.is_poisoned = False

    def __del__(self) -> None:
        if not self.is_closed and not self.is_released:
            if self.in_transaction:
                try:
                    self.conn.execute("ROLLBACK")
                except Exception as e_rb:
                    pass
                self.in_transaction = False
            if self.owns_conn:
                try:
                    self.conn.close()
                except Exception as e_cl:
                    pass
                self.is_closed = True

    def is_ok(self) -> bool:
        if self.is_closed or self.is_released or self.is_poisoned:
            return False
        return self.conn.is_ok()

    def set_query_timeout(self, ms: int) -> None:
        self._ensure_open()
        self.conn.set_query_timeout(ms)

    def set_statement_timeout(self, ms: int) -> None:
        self._ensure_open()
        self.conn.set_statement_timeout(ms)

    def set_lock_timeout(self, ms: int) -> None:
        self._ensure_open()
        self.conn.set_lock_timeout(ms)

    def cancel(self) -> bool:
        if self.is_closed or self.is_released:
            return False
        return self.conn.cancel()

    def transaction(self) -> Transaction:
        self._ensure_open()
        return Transaction(self)

    def run_in_tx(self, fn: (Transaction) -> None, *, retries: int = 0, backoff_ms: int = 5) -> None:
        attempt: int = 0
        while True:
            self._ensure_open()
            tx: Transaction = Transaction(self)
            should_retry: bool = False
            tx.begin()
            try:
                fn(tx)
                if tx.is_active():
                    tx.commit()
                return
            except FeatherError as fe:
                rb_err: str = ""
                if tx.state == TX_STATE_ACTIVE or tx.state == TX_STATE_FAILED:
                    try:
                        tx.rollback()
                    except Exception as e_rb:
                        self.is_poisoned = True
                        rb_err = e_rb.message
                if (fe.is_retryable() or is_retryable_message(fe.message)) and attempt < retries and not self.is_poisoned:
                    should_retry = True
                elif rb_err != "":
                    raise FeatherError(fe.message + " (rollback also failed: " + rb_err + ")", fe.sqlstate, fe.table, fe.column, fe.constraint) from fe
                else:
                    raise
            except PostgresError as pge:
                rb_err2: str = ""
                if tx.state == TX_STATE_ACTIVE or tx.state == TX_STATE_FAILED:
                    try:
                        tx.rollback()
                    except Exception as e_rb2:
                        self.is_poisoned = True
                        rb_err2 = e_rb2.message
                mapped: FeatherError = from_postgres_error(pge)
                if (pge.is_retryable() or mapped.is_retryable()) and attempt < retries and not self.is_poisoned:
                    should_retry = True
                elif rb_err2 != "":
                    raise TransactionError(mapped.message + " (rollback also failed: " + rb_err2 + ")", mapped.sqlstate, mapped.table, mapped.column, mapped.constraint) from pge
                else:
                    raise mapped from pge
            except Exception as e:
                rb_err3: str = ""
                if tx.state == TX_STATE_ACTIVE or tx.state == TX_STATE_FAILED:
                    try:
                        tx.rollback()
                    except Exception as e_rb3:
                        self.is_poisoned = True
                        rb_err3 = e_rb3.message
                if is_retryable_message(e.message) and attempt < retries and not self.is_poisoned:
                    should_retry = True
                elif rb_err3 != "":
                    raise TransactionError(e.message + " (rollback also failed: " + rb_err3 + ")") from e
                else:
                    raise
            if should_retry:
                attempt = attempt + 1
                if backoff_ms > 0:
                    nox.time.sleep_ms(backoff_ms * attempt)

    def _ensure_open(self, allow_cleanup: bool = False) -> None:
        if self.is_closed or self.is_released:
            raise ConnectionError("cannot execute operation on a closed or released Session")
        if self.is_poisoned and not allow_cleanup:
            raise ConnectionError("cannot execute operation on a poisoned Session: connection or transaction state is corrupted")

    def create_table(self, tbl: Table) -> None:
        self._ensure_open()
        sql: str = self.dialect.create_table_sql(tbl)
        self.conn.execute(sql)

    def drop_table(self, tbl: Table) -> None:
        self._ensure_open()
        sql: str = self.dialect.drop_table_sql(tbl)
        self.conn.execute(sql)

    def execute_raw(self, sql: str, params: list[Value]) -> int:
        upper_sql: str = nox.strings.upper(sql)
        tokens: list[str] = _extract_sql_tokens(upper_sql)

        is_cleanup: bool = (len(tokens) > 0 and tokens[0] == "ROLLBACK")
        self._ensure_open(is_cleanup)
        affected: int = 0
        try:
            stmt: Statement = self.conn.prepare(sql)
            i: int = 0
            while i < len(params):
                bind_value(stmt, i, params[i])
                i = i + 1
            affected = stmt.execute()
        except FeatherError:
            raise
        except PostgresError as pge:
            raise from_postgres_error(pge) from pge
        except Exception as e:
            raise classify_driver_error(e.message) from e

        first_token: str = ""
        second_token: str = ""
        if len(tokens) > 0:
            first_token = tokens[0]
        if len(tokens) > 1:
            second_token = tokens[1]

        if first_token == "BEGIN" or (first_token == "START" and second_token == "TRANSACTION"):
            self.in_transaction = True
        elif first_token == "COMMIT" or first_token == "ROLLBACK" or first_token == "END":
            self.in_transaction = False
        return affected

    def execute_script(self, sql: str) -> int:
        # Executes multi-statement unparameterized DDL/migration scripts (nox.sqlite 2.1.195+ execute_script / PQexec)
        self._ensure_open()
        try:
            return self.conn.execute(sql)
        except FeatherError:
            raise
        except PostgresError as pge:
            raise from_postgres_error(pge) from pge
        except Exception as e:
            raise classify_driver_error(e.message) from e

    def query_raw(self, sql: str, params: list[Value]) -> list[Row]:
        self._ensure_open()
        try:
            stmt: Statement = self.conn.prepare(sql)
            i: int = 0
            while i < len(params):
                bind_value(stmt, i, params[i])
                i = i + 1
            return stmt.query()
        except FeatherError:
            raise
        except PostgresError as pge:
            raise from_postgres_error(pge) from pge
        except Exception as e:
            raise classify_driver_error(e.message) from e

    def insert(self, tbl: Table, values_dict: dict[str, Value]) -> int:
        self._ensure_open()
        col_names: list[str] = []
        placeholders: list[str] = []
        bound_vals: list[Value] = []

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values_dict.contains(col.name):
                col_names.append(self.dialect.quote_identifier(col.name))
                placeholders.append(self.dialect.placeholder(len(bound_vals)))
                bound_vals.append(values_dict[col.name])
            i = i + 1

        if len(col_names) == 0:
            raise QueryBuildError("insert requires at least one column value")

        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "INSERT INTO " + q_table + " (" + nox.strings.join(col_names, ", ") + ") VALUES (" + nox.strings.join(placeholders, ", ") + ")"

        # PostgreSQL returning ID support
        if self.dialect.supports_returning() and tbl.primary_key != "":
            sql = sql + " RETURNING " + self.dialect.quote_identifier(tbl.primary_key)
            rows: list[Row] = self.query_raw(sql, bound_vals)
            if len(rows) > 0:
                return rows[0].get_int(0)
            return 0

        affected: int = self.execute_raw(sql, bound_vals)

        # For SQLite, last_insert_rowid returns generated ID
        if tbl.primary_key != "":
            if self.dialect.kind == DIALECT_SQLITE:
                empty_params: list[Value] = []
                r_rows: list[Row] = self.query_raw("SELECT last_insert_rowid()", empty_params)
                if len(r_rows) > 0:
                    return r_rows[0].get_int(0)

        return affected

    def insert_many(self, tbl: Table, rows: list[dict[str, Value]]) -> int:
        self._ensure_open()
        if len(rows) == 0:
            return 0

        col_names: list[str] = []
        i: int = 0
        while i < len(tbl.columns):
            c: Column = tbl.columns[i]
            if rows[0].contains(c.name):
                col_names.append(c.name)
            i = i + 1

        if len(col_names) == 0:
            raise QueryBuildError("insert_many requires at least one column value")

        q_col_names: list[str] = []
        c_idx: int = 0
        while c_idx < len(col_names):
            q_col_names.append(self.dialect.quote_identifier(col_names[c_idx]))
            c_idx = c_idx + 1

        row_placeholders: list[str] = []
        bound_vals: list[Value] = []

        r_idx: int = 0
        while r_idx < len(rows):
            row_dict: dict[str, Value] = rows[r_idx]
            if len(row_dict) != len(col_names):
                raise QueryBuildError("insert_many requires all rows to have the exact same column set: row " + str(r_idx) + " has " + str(len(row_dict)) + " columns, expected " + str(len(col_names)))
            single_row_phs: list[str] = []
            k: int = 0
            while k < len(col_names):
                c_name: str = col_names[k]
                if not row_dict.contains(c_name):
                    raise QueryBuildError("insert_many requires all rows to have the exact same column set: row " + str(r_idx) + " is missing column '" + c_name + "'")
                bound_vals.append(row_dict[c_name])
                single_row_phs.append(self.dialect.placeholder(len(bound_vals) - 1))
                k = k + 1
            row_placeholders.append("(" + nox.strings.join(single_row_phs, ", ") + ")")
            r_idx = r_idx + 1

        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "INSERT INTO " + q_table + " (" + nox.strings.join(q_col_names, ", ") + ") VALUES " + nox.strings.join(row_placeholders, ", ")

        return self.execute_raw(sql, bound_vals)

    def upsert(self, tbl: Table, values: dict[str, Value], conflict_target: list[str], update_values: dict[str, Value]) -> int:
        self._ensure_open()
        insert_cols: list[str] = []
        all_params: list[Value] = []

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values.contains(col.name):
                insert_cols.append(col.name)
                all_params.append(values[col.name])
            i = i + 1

        if len(insert_cols) == 0:
            raise QueryBuildError("upsert requires at least one insert column value")

        if (self.dialect.kind == DIALECT_SQLITE or self.dialect.kind == DIALECT_POSTGRES) and len(conflict_target) == 0:
            raise QueryBuildError("conflict_target must not be empty for SQLite / PostgreSQL upsert")

        c_idx: int = 0
        while c_idx < len(conflict_target):
            c_name: str = conflict_target[c_idx]
            assert_valid_identifier(c_name, "conflict target")
            if not tbl.has_column(c_name):
                raise QueryBuildError("conflict target column '" + c_name + "' not found in table " + tbl.name)
            c_idx = c_idx + 1

        update_cols: list[str] = []
        j: int = 0
        while j < len(tbl.columns):
            col2: Column = tbl.columns[j]
            if update_values.contains(col2.name):
                update_cols.append(col2.name)
                all_params.append(update_values[col2.name])
            j = j + 1

        sql: str = self.dialect.upsert_sql(tbl, insert_cols, conflict_target, update_cols)
        return self.execute_raw(sql, all_params)

    def update(self, tbl: Table, values_dict: dict[str, Value], where_clause: WhereClause) -> int:
        self._ensure_open()
        if where_clause.is_empty():
            raise QueryBuildError("unfiltered UPDATE prohibited: where_clause must not be empty on table " + tbl.name)

        set_parts: list[str] = []
        collector: ParamCollector = ParamCollector()

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values_dict.contains(col.name):
                q_col: str = self.dialect.quote_identifier(col.name)
                ph: str = self.dialect.placeholder(collector.count())
                set_parts.append(q_col + " = " + ph)
                collector.add(values_dict[col.name])
            i = i + 1

        if len(set_parts) == 0:
            return 0

        q_table: str = self.dialect.quote_identifier(tbl.name)
        w_sql: str = compile_where_clause(where_clause, self.dialect, collector)
        sql: str = "UPDATE " + q_table + " SET " + nox.strings.join(set_parts, ", ") + " WHERE " + w_sql
        return self.execute_raw(sql, collector.params)

    def update_fields(self, tbl: Table, where_clause: WhereClause, **fields: Value) -> int:
        return self.update(tbl, fields, where_clause)

    def update_by_id(self, tbl: Table, id_val: Value, values_dict: dict[str, Value]) -> int:
        if tbl.primary_key == "":
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        wc.add(eq(tbl.primary_key, id_val), 1)
        return self.update(tbl, values_dict, wc)

    def update_by_pk(self, tbl: Table, pk_values: dict[str, Value], values_dict: dict[str, Value]) -> int:
        if len(tbl.primary_keys) == 0:
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        i: int = 0
        while i < len(tbl.primary_keys):
            pk_name: str = tbl.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + tbl.name)
            wc.add(eq(pk_name, pk_values[pk_name]), 1)
            i = i + 1
        return self.update(tbl, values_dict, wc)

    def save_changes(self, tbl: Table, pk_values: dict[str, Value], original: dict[str, Value], current: dict[str, Value]) -> int:
        self._ensure_open()
        diff: dict[str, Value] = compute_dirty_fields(tbl, original, current)
        if len(diff) == 0:
            return 0
        return self.update_by_pk(tbl, pk_values, diff)

    def delete(self, tbl: Table, where_clause: WhereClause) -> int:
        self._ensure_open()
        if where_clause.is_empty():
            raise QueryBuildError("unfiltered DELETE prohibited: where_clause must not be empty on table " + tbl.name)

        collector: ParamCollector = ParamCollector()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        w_sql: str = compile_where_clause(where_clause, self.dialect, collector)
        sql: str = "DELETE FROM " + q_table + " WHERE " + w_sql
        return self.execute_raw(sql, collector.params)

    def delete_by_id(self, tbl: Table, id_val: Value) -> int:
        if tbl.primary_key == "":
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        wc.add(eq(tbl.primary_key, id_val), 1)
        return self.delete(tbl, wc)

    def delete_by_pk(self, tbl: Table, pk_values: dict[str, Value]) -> int:
        if len(tbl.primary_keys) == 0:
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        i: int = 0
        while i < len(tbl.primary_keys):
            pk_name: str = tbl.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + tbl.name)
            wc.add(eq(pk_name, pk_values[pk_name]), 1)
            i = i + 1
        return self.delete(tbl, wc)

    def count(self, tbl: Table) -> int:
        self._ensure_open()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "SELECT COUNT(*) FROM " + q_table
        empty_params: list[Value] = []
        rows: list[Row] = self.query_raw(sql, empty_params)
        if len(rows) > 0:
            return rows[0].get_int(0)
        return 0

    def count_where(self, tbl: Table, where_clause: WhereClause) -> int:
        self._ensure_open()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "SELECT COUNT(*) FROM " + q_table
        collector: ParamCollector = ParamCollector()

        if not where_clause.is_empty():
            sql = sql + " WHERE " + compile_where_clause(where_clause, self.dialect, collector)

        rows: list[Row] = self.query_raw(sql, collector.params)
        if len(rows) > 0:
            return rows[0].get_int(0)
        return 0

    def execute_query[T](self, model: Model[T], q: SelectQuery) -> list[T]:
        self._ensure_open()
        compiled: CompiledQuery = q.compile(self.dialect)
        rows: list[Row] = self.query_raw(compiled.sql, compiled.params)
        return model.decode_rows(rows)

    def stream[T](self, model: Model[T], q: SelectQuery, chunk_size: int = 100) -> Iterator[T]:
        if chunk_size <= 0:
            raise QueryBuildError("chunk_size must be > 0")
        self._ensure_open()
        base_limit: int = q.limit_val
        base_offset: int = q.offset_val
        if base_offset < 0:
            base_offset = 0
        yielded: int = 0
        cur_offset: int = base_offset

        while True:
            take: int = chunk_size
            if base_limit >= 0:
                rem: int = base_limit - yielded
                if rem <= 0:
                    break
                if rem < take:
                    take = rem

            chunk_q: SelectQuery = q.clone()
            chunk_q.limit(take)
            chunk_q.offset(cur_offset)
            items: list[T] = self.execute_query[T](model, chunk_q)
            if len(items) == 0:
                break

            idx: int = 0
            while idx < len(items):
                yield items[idx]
                yielded = yielded + 1
                idx = idx + 1

            if len(items) < take:
                break
            cur_offset = cur_offset + len(items)

    def stream_rows(self, q: SelectQuery, *, chunk_size: int = 100) -> Iterator[Row]:
        if chunk_size <= 0:
            raise QueryBuildError("chunk_size must be > 0")
        self._ensure_open()
        base_limit: int = q.limit_val
        base_offset: int = q.offset_val
        if base_offset < 0:
            base_offset = 0
        yielded: int = 0
        cur_offset: int = base_offset

        while True:
            take: int = chunk_size
            if base_limit >= 0:
                rem: int = base_limit - yielded
                if rem <= 0:
                    break
                if rem < take:
                    take = rem

            chunk_q: SelectQuery = q.clone()
            chunk_q.limit(take)
            chunk_q.offset(cur_offset)
            compiled: CompiledQuery = chunk_q.compile(self.dialect)
            rows: list[Row] = self.query_raw(compiled.sql, compiled.params)
            if len(rows) == 0:
                break

            idx: int = 0
            while idx < len(rows):
                yield rows[idx]
                yielded = yielded + 1
                idx = idx + 1

            if len(rows) < take:
                break
            cur_offset = cur_offset + len(rows)

    def stream_keyset[T](self, model: Model[T], pk_col: str, chunk_size: int = 100) -> Iterator[T]:
        if chunk_size <= 0:
            raise QueryBuildError("chunk_size must be > 0")
        assert_valid_identifier(pk_col, "keyset primary key")
        self._ensure_open()

        has_last: bool = False
        last_pk: Value = val_null()
        while True:
            q: SelectQuery = select_all(model.table.name)
            if has_last:
                q.where(gt(pk_col, last_pk))
            q.order_by(pk_col, ORDER_ASC)
            q.limit(chunk_size)
            compiled: CompiledQuery = q.compile(self.dialect)
            rows: list[Row] = self.query_raw(compiled.sql, compiled.params)
            if len(rows) == 0:
                break

            last_row: Row = rows[len(rows) - 1]
            pk_idx: int = mapper.find_column_index(last_row, pk_col)
            if pk_idx < 0:
                raise QueryBuildError("keyset column '" + pk_col + "' missing from query result")

            is_int_pk: bool = False
            ci: int = 0
            while ci < len(model.table.columns):
                c: Column = model.table.columns[ci]
                if c.name == pk_col and c.data_type == TYPE_INTEGER:
                    is_int_pk = True
                ci = ci + 1
            if is_int_pk:
                last_pk = val_int(last_row.get_int(pk_idx))
            else:
                last_pk = val_str(last_row.get_str(pk_idx))
            has_last = True

            i: int = 0
            while i < len(rows):
                yield model.decode(rows[i])
                i = i + 1

            if len(rows) < chunk_size:
                break

    def find_all[T](self, model: Model[T]) -> list[T]:
        q: SelectQuery = select_all(model.table.name)
        return self.execute_query[T](model, q)

    def find_by_id[T](self, model: Model[T], id_val: Value) -> T | None:
        if model.table.primary_key == "":
            raise QueryBuildError("table " + model.table.name + " has no primary key defined")
        q: SelectQuery = select_all(model.table.name)
        q.where(eq(model.table.primary_key, id_val))
        q.limit(1)
        res: list[T] = self.execute_query[T](model, q)
        if len(res) > 0:
            return res[0]
        return None

    def find_by_pk[T](self, model: Model[T], pk_values: dict[str, Value]) -> T | None:
        if len(model.table.primary_keys) == 0:
            raise QueryBuildError("table " + model.table.name + " has no primary key defined")
        q: SelectQuery = select_all(model.table.name)
        i: int = 0
        while i < len(model.table.primary_keys):
            pk_name: str = model.table.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + model.table.name)
            q.where(eq(pk_name, pk_values[pk_name]))
            i = i + 1
        q.limit(1)
        res: list[T] = self.execute_query[T](model, q)
        if len(res) > 0:
            return res[0]
        return None

    def find_where[T](self, model: Model[T], pred: Predicate) -> list[T]:
        q: SelectQuery = select_all(model.table.name)
        q.where(pred)
        return self.execute_query[T](model, q)

    def close(self) -> None:
        if self.owns_conn and not self.is_closed:
            self.conn.close()
            self.is_closed = True

def compute_dirty_fields(tbl: Table, original: dict[str, Value], current: dict[str, Value]) -> dict[str, Value]:
    diff: dict[str, Value] = {}
    i: int = 0
    while i < len(tbl.columns):
        col: Column = tbl.columns[i]
        c_name: str = col.name
        if current.contains(c_name) and not col.is_primary_key:
            cur_val: Value = current[c_name]
            if not original.contains(c_name):
                diff[c_name] = cur_val
            else:
                orig_val: Value = original[c_name]
                if not orig_val.equals(cur_val):
                    diff[c_name] = cur_val
        i = i + 1
    return diff

def begin_transaction(s: Session) -> Transaction:
    tx: Transaction = Transaction(s)
    tx.begin()
    return tx

def create_session(conn: DbConnection, dialect: Dialect, owns_conn: bool = True) -> Session:
    fc: FeatherConn = wrap_db_connection(conn)
    return Session(fc, dialect, owns_conn)

def create_postgres_session(conn: nox.postgres.Connection, dialect: Dialect, owns_conn: bool = True) -> Session:
    fc: FeatherConn = wrap_postgres_connection(conn)
    return Session(fc, dialect, owns_conn)

def safe_sqlite_path(root_dir: str, db_path: str) -> str:
    clean: str = nox.strings.trim(db_path)
    if len(clean) == 0:
        raise ConnectionError("SQLite database path cannot be empty")
    try:
        return nox.path.safe_join(root_dir, clean)
    except PathError as e:
        raise ConnectionError("unsafe SQLite database path rejected: " + e.message) from e
