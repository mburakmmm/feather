# session.nox — Unit of work, database connection wrapper, and CRUD operations for Feather.

import nox.db
from nox.db import DbConnection, Row, Statement
import metadata
from metadata import Table, Column
import value
from value import Value, val_int, val_str, val_float, val_bool, val_null, bind_value
import dialects
from dialects import Dialect, DIALECT_SQLITE, DIALECT_POSTGRES, DIALECT_MYSQL
import query
from query import SelectQuery, WhereClause, Predicate, CompiledQuery, ParamCollector, eq, select, select_all, compile_where_clause, OP_IS_NULL, OP_IS_NOT_NULL, OP_IN, OP_NEQ, OP_GT, OP_GTE, OP_LT, OP_LTE, OP_LIKE, LOGIC_OR
import mapper
from mapper import Model
import errors
from errors import ConnectionError, QueryBuildError, FeatherError
import nox.strings

class FeatherConn:
    prepare_fn: (str) -> Statement
    execute_fn: (str) -> int
    query_fn: (str) -> list[Row]
    close_fn: () -> None

    def __init__(self, prepare_fn: (str) -> Statement, execute_fn: (str) -> int, query_fn: (str) -> list[Row], close_fn: () -> None) -> None:
        self.prepare_fn = prepare_fn
        self.execute_fn = execute_fn
        self.query_fn = query_fn
        self.close_fn = close_fn

    def prepare(self, sql: str) -> Statement:

        f: (str) -> Statement = self.prepare_fn
        return f(sql)

    def execute(self, sql: str) -> int:

        f: (str) -> int = self.execute_fn
        return f(sql)

    def query(self, sql: str) -> list[Row]:

        f: (str) -> list[Row] = self.query_fn
        return f(sql)

    def close(self) -> None:

        f: () -> None = self.close_fn
        f()

def wrap_db_connection(conn: DbConnection) -> FeatherConn:
    def _prep(sql: str) -> Statement:
        return conn.prepare(sql)
    def _exec(sql: str) -> int:
        return conn.execute(sql)
    def _query(sql: str) -> list[Row]:
        return conn.query(sql)
    def _close() -> None:
        conn.close()
    return FeatherConn(_prep, _exec, _query, _close)

class Session:
    conn: FeatherConn
    dialect: Dialect
    owns_conn: bool
    is_closed: bool
    pool_id: int
    lease_id: int
    is_released: bool
    in_transaction: bool

    def __init__(self, conn: FeatherConn, dialect: Dialect, owns_conn: bool = True, pool_id: int = 0, lease_id: int = 0) -> None:
        self.conn = conn
        self.dialect = dialect
        self.owns_conn = owns_conn
        self.is_closed = False
        self.pool_id = pool_id
        self.lease_id = lease_id
        self.is_released = False
        self.in_transaction = False

    def _ensure_open(self) -> None:

        if self.is_closed or self.is_released:
            raise ConnectionError("cannot execute operation on a closed or released Session")

    def create_table(self, tbl: Table) -> None:

        self._ensure_open()
        sql: str = self.dialect.create_table_sql(tbl)
        self.conn.execute(sql)

    def drop_table(self, tbl: Table) -> None:

        self._ensure_open()
        sql: str = self.dialect.drop_table_sql(tbl)
        self.conn.execute(sql)

    def execute_raw(self, sql: str, params: list[Value]) -> int:

        self._ensure_open()
        stmt: Statement = self.conn.prepare(sql)
        i: int = 0
        while i < len(params):
            bind_value(stmt, i, params[i])
            i = i + 1
        affected: int = stmt.execute()
        trimmed: str = nox.strings.upper(nox.strings.trim(sql))
        if trimmed == "BEGIN" or trimmed == "BEGIN TRANSACTION" or trimmed == "START TRANSACTION":
            self.in_transaction = True
        elif trimmed == "COMMIT" or trimmed == "ROLLBACK":
            self.in_transaction = False
        return affected

    def query_raw(self, sql: str, params: list[Value]) -> list[Row]:

        self._ensure_open()
        stmt: Statement = self.conn.prepare(sql)
        i: int = 0
        while i < len(params):
            bind_value(stmt, i, params[i])
            i = i + 1
        return stmt.query()

    def insert(self, tbl: Table, values_dict: dict[str, Value]) -> int:

        self._ensure_open()
        col_names: list[str] = []
        placeholders: list[str] = []
        bound_vals: list[Value] = []

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values_dict.contains(col.name):
                col_names.append(self.dialect.quote_identifier(col.name))
                placeholders.append(self.dialect.placeholder(len(bound_vals)))
                bound_vals.append(values_dict[col.name])
            i = i + 1

        if len(col_names) == 0:
            raise QueryBuildError("insert requires at least one column value")

        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "INSERT INTO " + q_table + " (" + nox.strings.join(col_names, ", ") + ") VALUES (" + nox.strings.join(placeholders, ", ") + ")"

        # PostgreSQL returning ID support
        if self.dialect.supports_returning() and tbl.primary_key != "":
            sql = sql + " RETURNING " + self.dialect.quote_identifier(tbl.primary_key)
            rows: list[Row] = self.query_raw(sql, bound_vals)
            if len(rows) > 0:
                return rows[0].get_int(0)
            return 0

        affected: int = self.execute_raw(sql, bound_vals)

        # For SQLite, last_insert_rowid returns generated ID
        if tbl.primary_key != "":
            if self.dialect.kind == DIALECT_SQLITE:
                empty_params: list[Value] = []
                r_rows: list[Row] = self.query_raw("SELECT last_insert_rowid()", empty_params)
                if len(r_rows) > 0:
                    return r_rows[0].get_int(0)

        return affected

    def insert_many(self, tbl: Table, rows: list[dict[str, Value]]) -> int:
        self._ensure_open()
        if len(rows) == 0:
            return 0

        col_names: list[str] = []
        i: int = 0
        while i < len(tbl.columns):
            c: Column = tbl.columns[i]
            if rows[0].contains(c.name):
                col_names.append(c.name)
            i = i + 1

        if len(col_names) == 0:
            raise QueryBuildError("insert_many requires at least one column value")

        q_col_names: list[str] = []
        c_idx: int = 0
        while c_idx < len(col_names):
            q_col_names.append(self.dialect.quote_identifier(col_names[c_idx]))
            c_idx = c_idx + 1

        row_placeholders: list[str] = []
        bound_vals: list[Value] = []

        r_idx: int = 0
        while r_idx < len(rows):
            row_dict: dict[str, Value] = rows[r_idx]
            if len(row_dict) != len(col_names):
                raise QueryBuildError("insert_many requires all rows to have the exact same column set: row " + str(r_idx) + " has " + str(len(row_dict)) + " columns, expected " + str(len(col_names)))
            single_row_phs: list[str] = []
            k: int = 0
            while k < len(col_names):
                c_name: str = col_names[k]
                if not row_dict.contains(c_name):
                    raise QueryBuildError("insert_many requires all rows to have the exact same column set: row " + str(r_idx) + " is missing column '" + c_name + "'")
                bound_vals.append(row_dict[c_name])
                single_row_phs.append(self.dialect.placeholder(len(bound_vals) - 1))
                k = k + 1
            row_placeholders.append("(" + nox.strings.join(single_row_phs, ", ") + ")")
            r_idx = r_idx + 1

        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "INSERT INTO " + q_table + " (" + nox.strings.join(q_col_names, ", ") + ") VALUES " + nox.strings.join(row_placeholders, ", ")

        return self.execute_raw(sql, bound_vals)

    def upsert(self, tbl: Table, values: dict[str, Value], conflict_target: list[str], update_values: dict[str, Value]) -> int:

        self._ensure_open()
        insert_cols: list[str] = []
        all_params: list[Value] = []

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values.contains(col.name):
                insert_cols.append(col.name)
                all_params.append(values[col.name])
            i = i + 1

        if len(insert_cols) == 0:
            raise QueryBuildError("upsert requires at least one insert column value")

        if (self.dialect.kind == DIALECT_SQLITE or self.dialect.kind == DIALECT_POSTGRES) and len(conflict_target) == 0:
            raise QueryBuildError("conflict_target must not be empty for SQLite / PostgreSQL upsert")

        c_idx: int = 0
        while c_idx < len(conflict_target):
            c_name: str = conflict_target[c_idx]
            assert_valid_identifier(c_name, "conflict target")
            if not tbl.has_column(c_name):
                raise QueryBuildError("conflict target column '" + c_name + "' not found in table " + tbl.name)
            c_idx = c_idx + 1

        update_cols: list[str] = []
        j: int = 0
        while j < len(tbl.columns):
            col2: Column = tbl.columns[j]
            if update_values.contains(col2.name):
                update_cols.append(col2.name)
                all_params.append(update_values[col2.name])
            j = j + 1

        sql: str = self.dialect.upsert_sql(tbl, insert_cols, conflict_target, update_cols)
        return self.execute_raw(sql, all_params)

    def update(self, tbl: Table, values_dict: dict[str, Value], where_clause: WhereClause) -> int:

        self._ensure_open()
        if where_clause.is_empty():
            raise QueryBuildError("unfiltered UPDATE prohibited: where_clause must not be empty on table " + tbl.name)

        set_parts: list[str] = []
        collector: ParamCollector = ParamCollector()

        i: int = 0
        while i < len(tbl.columns):
            col: Column = tbl.columns[i]
            if values_dict.contains(col.name):
                q_col: str = self.dialect.quote_identifier(col.name)
                ph: str = self.dialect.placeholder(collector.count())
                set_parts.append(q_col + " = " + ph)
                collector.add(values_dict[col.name])
            i = i + 1

        if len(set_parts) == 0:
            return 0

        q_table: str = self.dialect.quote_identifier(tbl.name)
        w_sql: str = compile_where_clause(where_clause, self.dialect, collector)
        sql: str = "UPDATE " + q_table + " SET " + nox.strings.join(set_parts, ", ") + " WHERE " + w_sql
        return self.execute_raw(sql, collector.params)

    def update_by_id(self, tbl: Table, id_val: Value, values_dict: dict[str, Value]) -> int:

        if tbl.primary_key == "":
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        wc.add(eq(tbl.primary_key, id_val), 1)
        return self.update(tbl, values_dict, wc)

    def update_by_pk(self, tbl: Table, pk_values: dict[str, Value], values_dict: dict[str, Value]) -> int:

        if len(tbl.primary_keys) == 0:
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        i: int = 0
        while i < len(tbl.primary_keys):
            pk_name: str = tbl.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + tbl.name)
            wc.add(eq(pk_name, pk_values[pk_name]), 1)
            i = i + 1
        return self.update(tbl, values_dict, wc)

    def delete(self, tbl: Table, where_clause: WhereClause) -> int:

        self._ensure_open()
        if where_clause.is_empty():
            raise QueryBuildError("unfiltered DELETE prohibited: where_clause must not be empty on table " + tbl.name)

        collector: ParamCollector = ParamCollector()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        w_sql: str = compile_where_clause(where_clause, self.dialect, collector)
        sql: str = "DELETE FROM " + q_table + " WHERE " + w_sql
        return self.execute_raw(sql, collector.params)

    def delete_by_id(self, tbl: Table, id_val: Value) -> int:

        if tbl.primary_key == "":
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        wc.add(eq(tbl.primary_key, id_val), 1)
        return self.delete(tbl, wc)

    def delete_by_pk(self, tbl: Table, pk_values: dict[str, Value]) -> int:

        if len(tbl.primary_keys) == 0:
            raise QueryBuildError("table " + tbl.name + " has no primary key defined")
        wc: WhereClause = WhereClause()
        i: int = 0
        while i < len(tbl.primary_keys):
            pk_name: str = tbl.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + tbl.name)
            wc.add(eq(pk_name, pk_values[pk_name]), 1)
            i = i + 1
        return self.delete(tbl, wc)

    def count(self, tbl: Table) -> int:

        self._ensure_open()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "SELECT COUNT(*) FROM " + q_table
        empty_params: list[Value] = []
        rows: list[Row] = self.query_raw(sql, empty_params)
        if len(rows) > 0:
            return rows[0].get_int(0)
        return 0

    def count_where(self, tbl: Table, where_clause: WhereClause) -> int:

        self._ensure_open()
        q_table: str = self.dialect.quote_identifier(tbl.name)
        sql: str = "SELECT COUNT(*) FROM " + q_table
        collector: ParamCollector = ParamCollector()

        if not where_clause.is_empty():
            sql = sql + " WHERE " + compile_where_clause(where_clause, self.dialect, collector)

        rows: list[Row] = self.query_raw(sql, collector.params)
        if len(rows) > 0:
            return rows[0].get_int(0)
        return 0

    def execute_query[T](self, model: Model[T], q: SelectQuery) -> list[T]:

        self._ensure_open()
        compiled: CompiledQuery = q.compile(self.dialect)
        rows: list[Row] = self.query_raw(compiled.sql, compiled.params)
        return model.decode_rows(rows)

    def find_all[T](self, model: Model[T]) -> list[T]:

        q: SelectQuery = select_all(model.table.name)
        return self.execute_query[T](model, q)

    def find_by_id[T](self, model: Model[T], id_val: Value) -> T | None:

        if model.table.primary_key == "":
            raise QueryBuildError("table " + model.table.name + " has no primary key defined")
        q: SelectQuery = select_all(model.table.name)
        q.where(eq(model.table.primary_key, id_val))
        q.limit(1)
        res: list[T] = self.execute_query[T](model, q)
        if len(res) > 0:
            return res[0]
        return None

    def find_by_pk[T](self, model: Model[T], pk_values: dict[str, Value]) -> T | None:

        if len(model.table.primary_keys) == 0:
            raise QueryBuildError("table " + model.table.name + " has no primary key defined")
        q: SelectQuery = select_all(model.table.name)
        i: int = 0
        while i < len(model.table.primary_keys):
            pk_name: str = model.table.primary_keys[i]
            if pk_name not in pk_values:
                raise QueryBuildError("missing primary key column '" + pk_name + "' in pk_values for table " + model.table.name)
            q.where(eq(pk_name, pk_values[pk_name]))
            i = i + 1
        q.limit(1)
        res: list[T] = self.execute_query[T](model, q)
        if len(res) > 0:
            return res[0]
        return None

    def find_where[T](self, model: Model[T], pred: Predicate) -> list[T]:

        q: SelectQuery = select_all(model.table.name)
        q.where(pred)
        return self.execute_query[T](model, q)

    def close(self) -> None:

        if self.owns_conn and not self.is_closed:
            self.conn.close()
            self.is_closed = True

def create_session(conn: DbConnection, dialect: Dialect, owns_conn: bool = True) -> Session:
    fc: FeatherConn = wrap_db_connection(conn)
    return Session(fc, dialect, owns_conn)
