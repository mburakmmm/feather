import nox.sqlite

# Convenience helper for opening an SQLite session
def connect_sqlite(path: str) -> Session:
    c: nox.sqlite.Connection = nox.sqlite.open(path)
    return create_session(c, sqlite_dialect(), True)

# Convenience helper for opening an in-memory SQLite session
def open_sqlite_memory() -> Session:
    return connect_sqlite(":memory:")
