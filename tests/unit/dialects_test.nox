# tests/unit/dialects_test.nox — Unit tests for SQLite, PostgreSQL, and MySQL dialect generation.

import nox.test
import dialects
from dialects import Dialect, sqlite_dialect, postgres_dialect, mysql_dialect, DIALECT_SQLITE, DIALECT_POSTGRES, DIALECT_MYSQL
import metadata
from metadata import Column, Table, col_int, col_str, col_float, col_bool, table

d_sqlite: Dialect = sqlite_dialect()
d_pg: Dialect = postgres_dialect()
d_my: Dialect = mysql_dialect()

# 1. Identifier Quoting
nox.test.assert_eq_str(d_sqlite.quote_identifier("users"), "\"users\"", "SQLite quotes with double quotes")
nox.test.assert_eq_str(d_pg.quote_identifier("users"), "\"users\"", "PostgreSQL quotes with double quotes")
nox.test.assert_eq_str(d_my.quote_identifier("users"), "`users`", "MySQL quotes with backticks")

# 2. Parameter Placeholders
nox.test.assert_eq_str(d_sqlite.placeholder(0), "?", "SQLite placeholder is ?")
nox.test.assert_eq_str(d_sqlite.placeholder(3), "?", "SQLite placeholder is ?")
nox.test.assert_eq_str(d_my.placeholder(0), "?", "MySQL placeholder is ?")

nox.test.assert_eq_str(d_pg.placeholder(0), "$1", "PostgreSQL first placeholder is $1")
nox.test.assert_eq_str(d_pg.placeholder(1), "$2", "PostgreSQL second placeholder is $2")
nox.test.assert_eq_str(d_pg.placeholder(9), "$10", "PostgreSQL 10th placeholder is $10")

# 3. Column Types and DDL
c_pk_auto: Column = col_int("id", True, False, True)
c_text: Column = col_str("name")
c_bool: Column = col_bool("is_admin")
t: Table = table("users", [c_pk_auto, c_text, c_bool])

# SQLite DDL
sql_lite: str = d_sqlite.create_table_sql(t)
nox.test.assert_true("INTEGER PRIMARY KEY AUTOINCREMENT" in sql_lite, "SQLite auto PK is INTEGER PRIMARY KEY AUTOINCREMENT")
nox.test.assert_true("\"name\" TEXT NOT NULL" in sql_lite, "SQLite text column NOT NULL")

# PostgreSQL DDL
sql_pg: str = d_pg.create_table_sql(t)
nox.test.assert_true("SERIAL PRIMARY KEY" in sql_pg, "PostgreSQL auto PK is SERIAL PRIMARY KEY")
nox.test.assert_true("\"is_admin\" BOOLEAN NOT NULL" in sql_pg, "PostgreSQL boolean type is BOOLEAN")

# MySQL DDL
sql_my: str = d_my.create_table_sql(t)
nox.test.assert_true("INT AUTO_INCREMENT PRIMARY KEY" in sql_my, "MySQL auto PK is INT AUTO_INCREMENT PRIMARY KEY")
nox.test.assert_true("`is_admin` TINYINT(1) NOT NULL" in sql_my, "MySQL boolean type is TINYINT(1)")

# 4. Limit and Offset
nox.test.assert_eq_str(d_sqlite.limit_offset_sql(10, 20), " LIMIT 10 OFFSET 20", "Limit and offset formatting")
nox.test.assert_eq_str(d_sqlite.limit_offset_sql(10, -1), " LIMIT 10", "Limit only formatting")

# 5. RETURNING support
nox.test.assert_true(d_pg.supports_returning(), "PostgreSQL supports RETURNING")
nox.test.assert_true(not d_sqlite.supports_returning(), "SQLite does not rely on RETURNING")
nox.test.assert_true(not d_my.supports_returning(), "MySQL does not rely on RETURNING")

# 6. Migration Table DDL
mig_lite: str = d_sqlite.migration_table_sql()
nox.test.assert_true("\"id\" INTEGER PRIMARY KEY AUTOINCREMENT" in mig_lite, "SQLite migration table uses INTEGER PRIMARY KEY AUTOINCREMENT")
nox.test.assert_true("\"status\" TEXT NOT NULL DEFAULT 'APPLIED'" in mig_lite, "SQLite migration table has status column")

mig_pg: str = d_pg.migration_table_sql()
nox.test.assert_true("\"id\" SERIAL PRIMARY KEY" in mig_pg, "PostgreSQL migration table uses SERIAL PRIMARY KEY")
nox.test.assert_true("\"status\" TEXT NOT NULL DEFAULT 'APPLIED'" in mig_pg, "PostgreSQL migration table has status column")

mig_my: str = d_my.migration_table_sql()
nox.test.assert_true("`id` INT AUTO_INCREMENT PRIMARY KEY" in mig_my, "MySQL migration table uses INT AUTO_INCREMENT PRIMARY KEY")
nox.test.assert_true("`version` INT NOT NULL UNIQUE" in mig_my, "MySQL migration table uses INT for version")
nox.test.assert_true("`status` TEXT NOT NULL DEFAULT 'APPLIED'" in mig_my, "MySQL migration table has status column")

# 7. Transactional DDL Support
nox.test.assert_true(d_sqlite.supports_transactional_ddl(), "SQLite supports transactional DDL")
nox.test.assert_true(d_pg.supports_transactional_ddl(), "PostgreSQL supports transactional DDL")
nox.test.assert_true(not d_my.supports_transactional_ddl(), "MySQL DDL commits implicitly (non-transactional DDL)")

# 8. Migration Lock Table DDL & Row Init
lock_lite: str = d_sqlite.migration_lock_table_sql()
nox.test.assert_true("CREATE TABLE IF NOT EXISTS \"_feather_migration_lock\"" in lock_lite, "SQLite lock table DDL")
nox.test.assert_true("\"owner_token\" TEXT NOT NULL DEFAULT ''" in lock_lite, "SQLite lock table has owner_token")
nox.test.assert_true("\"timeout_at\" INTEGER NOT NULL DEFAULT 0" in lock_lite, "SQLite lock table has timeout_at")

lock_my: str = d_my.migration_lock_table_sql()
nox.test.assert_true("CREATE TABLE IF NOT EXISTS `_feather_migration_lock`" in lock_my, "MySQL lock table DDL")
nox.test.assert_true("`owner_token` VARCHAR(64) NOT NULL DEFAULT ''" in lock_my, "MySQL lock table has owner_token")
nox.test.assert_true("`timeout_at` INT NOT NULL DEFAULT 0" in lock_my, "MySQL lock table has timeout_at")

init_lite: str = d_sqlite.init_migration_lock_row_sql()
nox.test.assert_true("INSERT OR IGNORE INTO \"_feather_migration_lock\"" in init_lite, "SQLite lock row init uses INSERT OR IGNORE")

init_pg: str = d_pg.init_migration_lock_row_sql()
nox.test.assert_true("ON CONFLICT (\"id\") DO NOTHING" in init_pg, "PostgreSQL lock row init uses ON CONFLICT DO NOTHING")

init_my: str = d_my.init_migration_lock_row_sql()
nox.test.assert_true("ON DUPLICATE KEY UPDATE `id` = 1" in init_my, "MySQL lock row init uses ON DUPLICATE KEY UPDATE")

# 9. Advisory Lock SQL
nox.test.assert_true("pg_try_advisory_lock" in d_pg.advisory_lock_sql(""), "PostgreSQL uses pg_try_advisory_lock")
nox.test.assert_true("pg_advisory_unlock" in d_pg.advisory_unlock_sql(""), "PostgreSQL uses pg_advisory_unlock")
nox.test.assert_true("GET_LOCK" in d_my.advisory_lock_sql(""), "MySQL uses GET_LOCK")
nox.test.assert_true("RELEASE_LOCK" in d_my.advisory_unlock_sql(""), "MySQL uses RELEASE_LOCK")
nox.test.assert_eq_str(d_sqlite.advisory_lock_sql(""), "", "SQLite has no network advisory lock")

print("dialects_test passed")
