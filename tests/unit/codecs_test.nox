# tests/unit/codecs_test.nox — Unit tests for Decimal, DateTime, and UUID codecs.

import nox.test
import types
from types import Decimal, DateTime, UUID, decimal, datetime, parse_iso_datetime, uuid_parse, is_valid_uuid
import value
from value import Value, val_decimal, val_datetime, val_uuid
import nox.db
from nox.db import Row
import mapper
from mapper import row_get_decimal, row_get_opt_decimal, row_get_datetime, row_get_opt_datetime, row_get_uuid, row_get_opt_uuid

# 1. Decimal tests
d1: Decimal = decimal("123456789.987654321")
nox.test.assert_eq_str(d1.to_string(), "123456789.987654321", "Decimal preserves exact string without float precision loss")
nox.test.assert_true(d1.to_float() > 123456789.0, "Decimal converts to float")

d2: Decimal = decimal("-42.50")
nox.test.assert_eq_str(d2.to_string(), "-42.50", "Negative decimal parsed")

d1_dup: Decimal = decimal("123456789.987654321")
nox.test.assert_true(d1.equals(d1_dup), "Equal decimals match")
nox.test.assert_true(not d1.equals(d2), "Unequal decimals do not match")

v_dec: Value = val_decimal(d1)
nox.test.assert_eq_str(v_dec.to_string(), "123456789.987654321", "val_decimal to_string matches")

# 2. DateTime tests
dt1: DateTime = datetime(2026, 10, 27, 14, 30, 45)
nox.test.assert_eq_str(dt1.format_iso(), "2026-10-27T14:30:45Z", "DateTime formats to ISO-8601 UTC")

dt2: DateTime = parse_iso_datetime("2026-10-27T14:30:45Z")
nox.test.assert_true(dt1.equals(dt2), "Parsed ISO datetime equals constructed DateTime")
nox.test.assert_eq_int(dt2.year, 2026, "Year matches")
nox.test.assert_eq_int(dt2.month, 10, "Month matches")
nox.test.assert_eq_int(dt2.day, 27, "Day matches")
nox.test.assert_eq_int(dt2.hour, 14, "Hour matches")
nox.test.assert_eq_int(dt2.minute, 30, "Minute matches")
nox.test.assert_eq_int(dt2.second, 45, "Second matches")

v_dt: Value = val_datetime(dt1)
nox.test.assert_eq_str(v_dt.to_string(), "2026-10-27T14:30:45Z", "val_datetime to_string matches")

# 3. UUID tests
uuid_str: str = "123e4567-e89b-12d3-a456-426614174000"
nox.test.assert_true(is_valid_uuid(uuid_str), "Valid UUID string recognized")
nox.test.assert_true(not is_valid_uuid("not-a-uuid"), "Invalid string rejected as UUID")
nox.test.assert_true(not is_valid_uuid("123e4567-e89b-12d3-a456-42661417400"), "Wrong length rejected")

u1: UUID = uuid_parse(uuid_str)
nox.test.assert_eq_str(u1.to_string(), uuid_str, "UUID matches canonical string")

v_uuid: Value = val_uuid(u1)
nox.test.assert_eq_str(v_uuid.to_string(), uuid_str, "val_uuid to_string matches")

# 4. Row decoding of codecs
mock_row: Row = Row(
    ["99.95", "2026-10-27T14:30:45Z", uuid_str, ""],
    [False, False, False, True],
    ["price", "created_at", "trace_id", "opt_col"]
)

dec_row: Decimal = row_get_decimal(mock_row, 0)
nox.test.assert_eq_str(dec_row.to_string(), "99.95", "row_get_decimal works")

dt_row: DateTime = row_get_datetime(mock_row, 1)
nox.test.assert_eq_int(dt_row.year, 2026, "row_get_datetime works")

uuid_row: UUID = row_get_uuid(mock_row, 2)
nox.test.assert_eq_str(uuid_row.to_string(), uuid_str, "row_get_uuid works")

opt_dec: Decimal | None = row_get_opt_decimal(mock_row, 3)
nox.test.assert_true(opt_dec is None, "row_get_opt_decimal returns None for NULL")

opt_dt: DateTime | None = row_get_opt_datetime(mock_row, 3)
nox.test.assert_true(opt_dt is None, "row_get_opt_datetime returns None for NULL")

opt_uuid: UUID | None = row_get_opt_uuid(mock_row, 3)
nox.test.assert_true(opt_uuid is None, "row_get_opt_uuid returns None for NULL")

print("codecs_test passed")
