# value.nox — Type-safe parameter representation (both classic Value & ADT SqlValue) and statement binding for Feather.

import nox.db
from nox.db import Statement
import errors
from errors import BindingError
import types
from types import Decimal, DateTime, UUID

VAL_INT: int = 1
VAL_FLOAT: int = 2
VAL_STR: int = 3
VAL_BOOL: int = 4
VAL_NULL: int = 5

# Tagged Union / Algebraic Data Type representation for SQL values
enum SqlValue:
    Integer(v: int)
    Float(v: float)
    Text(v: str)
    Boolean(v: bool)
    Null

    def to_string(self: SqlValue) -> str:
        match self:
            case SqlValue.Integer(iv):
                return str(iv)
            case SqlValue.Float(fv):
                return str(fv)
            case SqlValue.Text(tv):
                return tv
            case SqlValue.Boolean(bv):
                if bv:
                    return "true"
                return "false"
            case SqlValue.Null:
                return "NULL"

def bind_sql_value(stmt: Statement, idx: int, sv: SqlValue) -> None:
    match sv:
        case SqlValue.Integer(iv):
            stmt.bind_int(idx, iv)
        case SqlValue.Float(fv):
            stmt.bind_float(idx, fv)
        case SqlValue.Text(tv):
            stmt.bind_str(idx, tv)
        case SqlValue.Boolean(bv):
            if bv:
                stmt.bind_int(idx, 1)
            else:
                stmt.bind_int(idx, 0)
        case SqlValue.Null:
            stmt.bind_null(idx)

class Value:
    kind: int
    i: int
    f: float
    s: str
    b: bool
    is_null: bool

    def __init__(self: Value, kind: int, i: int, f: float, s: str, b: bool, is_null: bool) -> None:
        self.kind = kind
        self.i = i
        self.f = f
        self.s = s
        self.b = b
        self.is_null = is_null

    def to_enum(self: Value) -> SqlValue:
        if self.kind == VAL_INT:
            return SqlValue.Integer(self.i)
        if self.kind == VAL_FLOAT:
            return SqlValue.Float(self.f)
        if self.kind == VAL_STR:
            return SqlValue.Text(self.s)
        if self.kind == VAL_BOOL:
            return SqlValue.Boolean(self.b)
        if self.kind == VAL_NULL:
            return SqlValue.Null
        raise BindingError("unsupported value kind: " + str(self.kind))

    def to_string(self: Value) -> str:
        if self.kind == VAL_INT:
            return str(self.i)
        if self.kind == VAL_FLOAT:
            return str(self.f)
        if self.kind == VAL_STR:
            return self.s
        if self.kind == VAL_BOOL:
            if self.b:
                return "true"
            return "false"
        return "NULL"

    def equals(self: Value, other: Value) -> bool:
        if self.kind != other.kind:
            return False
        if self.kind == VAL_INT:
            return self.i == other.i
        if self.kind == VAL_FLOAT:
            return self.f == other.f
        if self.kind == VAL_STR:
            return self.s == other.s
        if self.kind == VAL_BOOL:
            return self.b == other.b
        if self.kind == VAL_NULL:
            return True
        return False

def from_sql_value(sv: SqlValue) -> Value:
    match sv:
        case SqlValue.Integer(iv):
            return val_int(iv)
        case SqlValue.Float(fv):
            return val_float(fv)
        case SqlValue.Text(tv):
            return val_str(tv)
        case SqlValue.Boolean(bv):
            return val_bool(bv)
        case SqlValue.Null:
            return val_null()

def val_int(i: int) -> Value:
    return Value(VAL_INT, i, 0.0, "", False, False)

def val_float(f: float) -> Value:
    return Value(VAL_FLOAT, 0, f, "", False, False)

def val_str(s: str) -> Value:
    return Value(VAL_STR, 0, 0.0, s, False, False)

def val_bool(b: bool) -> Value:
    return Value(VAL_BOOL, 0, 0.0, "", b, False)

def val_null() -> Value:
    return Value(VAL_NULL, 0, 0.0, "", False, True)

def val_decimal(d: Decimal) -> Value:
    return Value(VAL_STR, 0, 0.0, d.to_string(), False, False)

def val_datetime(dt: DateTime) -> Value:
    return Value(VAL_STR, 0, 0.0, dt.format_iso(), False, False)

def val_uuid(u: UUID) -> Value:
    return Value(VAL_STR, 0, 0.0, u.to_string(), False, False)

def bind_value(stmt: Statement, idx: int, v: Value) -> None:
    bind_sql_value(stmt, idx, v.to_enum())

def format_bound_values(params: list[Value]) -> str:
    parts: list[str] = []
    i: int = 0
    while i < len(params):
        parts.append(params[i].to_string())
        i = i + 1
    out: str = "["
    j: int = 0
    while j < len(parts):
        if j > 0:
            out = out + ", "
        out = out + parts[j]
        j = j + 1
    return out + "]"
