# mapper.nox — Model definition, row decoding helpers, and generic typed mapping.

import nox.db
from nox.db import Row
import nox.json
from nox.json import JsonError, JsonWriter
import metadata
from metadata import Table, Column, TYPE_INTEGER, TYPE_TEXT, TYPE_REAL, TYPE_BOOLEAN
import value
from value import Value, val_int, val_str, val_float, val_bool, val_null, VAL_INT, VAL_FLOAT, VAL_STR, VAL_BOOL, VAL_NULL
import errors
from errors import MappingError
import types
from types import Decimal, DateTime, UUID, decimal, parse_iso_datetime, uuid_parse, json_parse

def row_is_null(row: Row, idx: int) -> bool:
    return row.is_null(idx)

def row_get_int(row: Row, idx: int) -> int:
    if row.is_null(idx):
        raise MappingError("column at index " + str(idx) + " is NULL, expected non-null int")
    return row.get_int(idx)

def row_get_str(row: Row, idx: int) -> str:
    if row.is_null(idx):
        raise MappingError("column at index " + str(idx) + " is NULL, expected non-null str")
    return row.get_str(idx)

def row_get_float(row: Row, idx: int) -> float:
    if row.is_null(idx):
        raise MappingError("column at index " + str(idx) + " is NULL, expected non-null float")
    return row.get_float(idx)

def row_get_bool(row: Row, idx: int) -> bool:
    if row.is_null(idx):
        raise MappingError("column at index " + str(idx) + " is NULL, expected non-null bool")
    s: str = row.get_str(idx)
    if s == "1" or s == "true" or s == "TRUE" or s == "t":
        return True
    return False

def row_get_opt_int(row: Row, idx: int) -> int | None:
    if row.is_null(idx):
        return None
    return row.get_int(idx)

def row_get_opt_str(row: Row, idx: int) -> str | None:
    if row.is_null(idx):
        return None
    return row.get_str(idx)

def row_get_opt_float(row: Row, idx: int) -> float | None:
    if row.is_null(idx):
        return None
    return row.get_float(idx)

def row_get_opt_bool(row: Row, idx: int) -> bool | None:
    if row.is_null(idx):
        return None
    return row_get_bool(row, idx)

def row_get_decimal(row: Row, idx: int) -> Decimal:
    s: str = row_get_str(row, idx)
    return decimal(s)

def row_get_opt_decimal(row: Row, idx: int) -> Decimal | None:
    if row.is_null(idx):
        return None
    return decimal(row.get_str(idx))

def row_get_datetime(row: Row, idx: int) -> DateTime:
    s: str = row_get_str(row, idx)
    return parse_iso_datetime(s)

def row_get_opt_datetime(row: Row, idx: int) -> DateTime | None:
    if row.is_null(idx):
        return None
    return parse_iso_datetime(row.get_str(idx))

def row_get_uuid(row: Row, idx: int) -> UUID:
    s: str = row_get_str(row, idx)
    return uuid_parse(s)

def row_get_opt_uuid(row: Row, idx: int) -> UUID | None:
    if row.is_null(idx):
        return None
    return uuid_parse(row.get_str(idx))

def find_column_index(row: Row, col_name: str) -> int:
    n: int = row.column_count()
    i: int = 0
    while i < n:
        if row.column_name(i) == col_name:
            return i
        i = i + 1
    return -1

def row_get_int_by_name(row: Row, col_name: str) -> int:
    idx: int = find_column_index(row, col_name)
    if idx < 0:
        raise MappingError("column not found in row: " + col_name)
    return row_get_int(row, idx)

def row_get_str_by_name(row: Row, col_name: str) -> str:
    idx: int = find_column_index(row, col_name)
    if idx < 0:
        raise MappingError("column not found in row: " + col_name)
    return row_get_str(row, idx)

def row_get_float_by_name(row: Row, col_name: str) -> float:
    idx: int = find_column_index(row, col_name)
    if idx < 0:
        raise MappingError("column not found in row: " + col_name)
    return row_get_float(row, idx)

def row_get_bool_by_name(row: Row, col_name: str) -> bool:
    idx: int = find_column_index(row, col_name)
    if idx < 0:
        raise MappingError("column not found in row: " + col_name)
    return row_get_bool(row, idx)

class Model[T]:
    table: Table
    decoder: (Row) -> T
    encoder: (T) -> dict[str, Value]

    def __init__(self, table: Table, decoder: (Row) -> T, encoder: (T) -> dict[str, Value]) -> None:
        self.table = table
        self.decoder = decoder
        self.encoder = encoder

    def decode(self, row: Row) -> T:

        d: (Row) -> T = self.decoder
        return d(row)

    def encode(self, obj: T) -> dict[str, Value]:

        e: (T) -> dict[str, Value] = self.encoder
        return e(obj)

    def decode_rows(self, rows: list[Row]) -> list[T]:

        out: list[T] = []
        i: int = 0
        while i < len(rows):
            out.append(self.decode(rows[i]))
            i = i + 1
        return out

def row_get_json(row: Row, idx: int) -> JsonValue:
    s: str = row_get_str(row, idx)
    return json_parse(s)

def row_get_json_by_name(row: Row, col_name: str) -> JsonValue:
    idx: int = find_column_index(row, col_name)
    if idx < 0:
        raise MappingError("column not found in row: " + col_name)
    return row_get_json(row, idx)

def row_get_opt_json(row: Row, idx: int) -> JsonValue | None:
    if row.is_null(idx):
        return None
    return json_parse(row.get_str(idx))

def json_to_value(v: JsonValue) -> Value:
    if nox.json.is_null(v):
        return val_null()
    if nox.json.is_bool(v):
        return val_bool(nox.json.as_bool(v))
    if nox.json.is_string(v):
        return val_str(nox.json.as_string(v))
    if nox.json.is_number(v):
        txt: str = nox.json.number_text(v)
        if "." in txt or "e" in txt or "E" in txt:
            return val_float(nox.json.as_number(v))
        try:
            return val_int(nox.json.as_int(v))
        except JsonError:
            return val_float(nox.json.as_number(v))
    return val_str(nox.json.dump(v))

def json_object_to_values(json_text: str) -> dict[str, Value]:
    root: JsonValue = json_parse(json_text)
    try:
        nox.json.expect_object(root, "model JSON payload")
    except JsonError as e:
        raise MappingError("expected JSON object payload: " + e.message)
    out: dict[str, Value] = {}
    n: int = nox.json.object_len(root)
    i: int = 0
    while i < n:
        k: str = nox.json.object_key(root, i)
        v: JsonValue = nox.json.object_value(root, i)
        out[k] = json_to_value(v)
        i = i + 1
    return out

def values_to_json(vals: dict[str, Value]) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_object()
    for k, v in vals.items():
        w.write_key(k)
        if v.kind == VAL_NULL:
            w.write_null()
        elif v.kind == VAL_INT:
            w.write_int(v.i)
        elif v.kind == VAL_FLOAT:
            w.write_float(v.f)
        elif v.kind == VAL_BOOL:
            w.write_bool(v.b)
        else:
            w.write_string(v.s)
    w.end_object()
    return w.build()

def row_to_json(row: Row, tbl: Table) -> str:
    w: JsonWriter = JsonWriter()
    w.begin_object()
    i: int = 0
    while i < len(tbl.columns):
        col: Column = tbl.columns[i]
        idx: int = find_column_index(row, col.name)
        if idx >= 0:
            w.write_key(col.name)
            if row_is_null(row, idx):
                if not col.is_nullable:
                    raise MappingError("column '" + col.name + "' is NULL, expected non-null")
                w.write_null()
            elif col.data_type == TYPE_INTEGER:
                w.write_int(row_get_int(row, idx))
            elif col.data_type == TYPE_REAL:
                w.write_float(row_get_float(row, idx))
            elif col.data_type == TYPE_BOOLEAN:
                w.write_bool(row_get_bool(row, idx))
            else:
                w.write_string(row_get_str(row, idx))
        i = i + 1
    w.end_object()
    return w.build()

def dataclass_model[T](tbl: Table, from_json_fn: (str) -> T, to_json_fn: (T) -> str) -> Model[T]:
    return Model[T](
        tbl,
        lambda r: from_json_fn(row_to_json(r, tbl)),
        lambda obj: json_object_to_values(to_json_fn(obj))
    )
