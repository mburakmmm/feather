# relations.nox — Relationship definitions (has_one, has_many, belongs_to) and eager loading.

import session
from session import Session
import mapper
from mapper import Model
import value
from value import Value
import query
from query import SelectQuery, eq, is_in, select_all
import errors
from errors import RelationError
import metadata
from metadata import assert_valid_identifier

import nox.db
from nox.db import Row

REL_HAS_ONE: int = 1
REL_HAS_MANY: int = 2
REL_BELONGS_TO: int = 3
REL_MANY_TO_MANY: int = 4

BATCH_CHUNK_SIZE: int = 500

class Relation:
    name: str
    rel_type: int
    source_table: str
    target_table: str
    foreign_key: str
    primary_key: str
    through_table: str
    target_foreign_key: str

    def __init__(self: Relation, name: str, rel_type: int, source_table: str, target_table: str, foreign_key: str, primary_key: str, through_table: str = "", target_foreign_key: str = "") -> None:
        assert_valid_identifier(name, "relation name")
        assert_valid_identifier(source_table, "source table")
        assert_valid_identifier(target_table, "target table")
        assert_valid_identifier(foreign_key, "foreign key")
        assert_valid_identifier(primary_key, "primary key")
        if through_table != "":
            assert_valid_identifier(through_table, "through table")
        if target_foreign_key != "":
            assert_valid_identifier(target_foreign_key, "target foreign key")
        self.name = name
        self.rel_type = rel_type
        self.source_table = source_table
        self.target_table = target_table
        self.foreign_key = foreign_key
        self.primary_key = primary_key
        self.through_table = through_table
        self.target_foreign_key = target_foreign_key

def has_one(name: str, source_table: str, target_table: str, foreign_key: str, primary_key: str) -> Relation:
    return Relation(name, REL_HAS_ONE, source_table, target_table, foreign_key, primary_key, "", "")

def has_many(name: str, parent_table: str, child_table: str, foreign_key: str, primary_key: str) -> Relation:
    return Relation(name, REL_HAS_MANY, parent_table, child_table, foreign_key, primary_key, "", "")

def belongs_to(name: str, child_table: str, parent_table: str, foreign_key: str, primary_key: str) -> Relation:
    return Relation(name, REL_BELONGS_TO, child_table, parent_table, foreign_key, primary_key, "", "")

def many_to_many(name: str, source_table: str, target_table: str, through_table: str, source_fk: str, target_fk: str, target_pk: str = "id") -> Relation:
    return Relation(name, REL_MANY_TO_MANY, source_table, target_table, source_fk, target_pk, through_table, target_fk)

class RelationLoader:
    session: Session

    def __init__(self: RelationLoader, session: Session) -> None:
        self.session = session

    def load_has_many[C](self: RelationLoader, child_model: Model[C], fk_column: str, parent_pk_val: Value) -> list[C]:

        q: SelectQuery = select_all(child_model.table.name)
        q.where(eq(fk_column, parent_pk_val))
        return self.session.execute_query[C](child_model, q)

    def load_has_many_batch[C](self: RelationLoader, child_model: Model[C], fk_column: str, parent_pk_vals: list[Value]) -> list[C]:
        if len(parent_pk_vals) == 0:
            empty: list[C] = []
            return empty

        if len(parent_pk_vals) <= BATCH_CHUNK_SIZE:
            q: SelectQuery = select_all(child_model.table.name)
            q.where(is_in(fk_column, parent_pk_vals))
            return self.session.execute_query[C](child_model, q)

        # Large batch: slice into chunks of BATCH_CHUNK_SIZE and aggregate
        all_results: list[C] = []
        offset: int = 0
        while offset < len(parent_pk_vals):
            chunk: list[Value] = []
            end_idx: int = offset + BATCH_CHUNK_SIZE
            if end_idx > len(parent_pk_vals):
                end_idx = len(parent_pk_vals)
            k: int = offset
            while k < end_idx:
                chunk.append(parent_pk_vals[k])
                k = k + 1
            q_chunk: SelectQuery = select_all(child_model.table.name)
            q_chunk.where(is_in(fk_column, chunk))
            chunk_res: list[C] = self.session.execute_query[C](child_model, q_chunk)
            m: int = 0
            while m < len(chunk_res):
                all_results.append(chunk_res[m])
                m = m + 1
            offset = offset + BATCH_CHUNK_SIZE
        return all_results

    def load_relation_has_many_batch[C](self: RelationLoader, rel: Relation, child_model: Model[C], parent_pk_vals: list[Value]) -> list[C]:
        if rel.rel_type != REL_HAS_MANY:
            raise RelationError("relation '" + rel.name + "' is not a has_many relation")
        return self.load_has_many_batch[C](child_model, rel.foreign_key, parent_pk_vals)

    def load_has_many_grouped[C](self: RelationLoader, child_model: Model[C], fk_column: str, parent_pk_vals: list[Value], get_fk: (C) -> int) -> dict[int, list[C]]:
        all_children: list[C] = self.load_has_many_batch[C](child_model, fk_column, parent_pk_vals)
        res: dict[int, list[C]] = {}
        i: int = 0
        while i < len(parent_pk_vals):
            pv: Value = parent_pk_vals[i]
            empty_init: list[C] = []
            res[pv.i] = empty_init
            i = i + 1

        j: int = 0
        while j < len(all_children):
            c: C = all_children[j]
            parent_id: int = get_fk(c)
            if res.contains(parent_id):
                sub: list[C] = res[parent_id]
                sub.append(c)
                res[parent_id] = sub
            else:
                new_list: list[C] = [c]
                res[parent_id] = new_list
            j = j + 1
        return res

    def load_relation_has_many_grouped[C](self: RelationLoader, rel: Relation, child_model: Model[C], parent_pk_vals: list[Value], get_fk: (C) -> int) -> dict[int, list[C]]:
        if rel.rel_type != REL_HAS_MANY:
            raise RelationError("relation '" + rel.name + "' is not a has_many relation")
        return self.load_has_many_grouped[C](child_model, rel.foreign_key, parent_pk_vals, get_fk)

    def load_belongs_to[P](self: RelationLoader, parent_model: Model[P], pk_column: str, fk_val: Value) -> P | None:

        q: SelectQuery = select_all(parent_model.table.name)
        q.where(eq(pk_column, fk_val))
        q.limit(1)
        rows: list[P] = self.session.execute_query[P](parent_model, q)
        if len(rows) > 0:
            return rows[0]
        return None

    def load_belongs_to_batch[P](self: RelationLoader, parent_model: Model[P], pk_column: str, fk_vals: list[Value]) -> list[P]:
        if len(fk_vals) == 0:
            empty: list[P] = []
            return empty

        if len(fk_vals) <= BATCH_CHUNK_SIZE:
            q: SelectQuery = select_all(parent_model.table.name)
            q.where(is_in(pk_column, fk_vals))
            return self.session.execute_query[P](parent_model, q)

        all_parents: list[P] = []
        offset_p: int = 0
        while offset_p < len(fk_vals):
            chunk_p: list[Value] = []
            end_p: int = offset_p + BATCH_CHUNK_SIZE
            if end_p > len(fk_vals):
                end_p = len(fk_vals)
            k_p: int = offset_p
            while k_p < end_p:
                chunk_p.append(fk_vals[k_p])
                k_p = k_p + 1
            q_chunk_p: SelectQuery = select_all(parent_model.table.name)
            q_chunk_p.where(is_in(pk_column, chunk_p))
            chunk_res_p: list[P] = self.session.execute_query[P](parent_model, q_chunk_p)
            m_p: int = 0
            while m_p < len(chunk_res_p):
                all_parents.append(chunk_res_p[m_p])
                m_p = m_p + 1
            offset_p = offset_p + BATCH_CHUNK_SIZE
        return all_parents

    def load_relation_belongs_to_batch[P](self: RelationLoader, rel: Relation, parent_model: Model[P], fk_vals: list[Value]) -> list[P]:
        if rel.rel_type != REL_BELONGS_TO:
            raise RelationError("relation '" + rel.name + "' is not a belongs_to relation")
        return self.load_belongs_to_batch[P](parent_model, rel.primary_key, fk_vals)

    def load_has_one[C](self: RelationLoader, child_model: Model[C], fk_column: str, parent_pk_val: Value) -> C | None:

        q: SelectQuery = select_all(child_model.table.name)
        q.where(eq(fk_column, parent_pk_val))
        q.limit(1)
        rows: list[C] = self.session.execute_query[C](child_model, q)
        if len(rows) > 0:
            return rows[0]
        return None

    def load_many_to_many[T](self: RelationLoader, target_model: Model[T], through_table: str, source_fk: str, target_fk: str, source_pk_val: Value, target_pk_col: str = "id") -> list[T]:

        assert_valid_identifier(through_table, "through table")
        assert_valid_identifier(source_fk, "source foreign key")
        assert_valid_identifier(target_fk, "target foreign key")
        assert_valid_identifier(target_pk_col, "target primary key")

        target_quoted: str = self.session.dialect.quote_identifier(target_model.table.name)
        through_quoted: str = self.session.dialect.quote_identifier(through_table)
        target_pk_quoted: str = self.session.dialect.quote_identifier(target_pk_col)
        target_fk_quoted: str = self.session.dialect.quote_identifier(target_fk)
        source_fk_quoted: str = self.session.dialect.quote_identifier(source_fk)

        ph0: str = self.session.dialect.placeholder(0)
        sql: str = "SELECT " + target_quoted + ".* FROM " + target_quoted + " INNER JOIN " + through_quoted + " ON " + target_quoted + "." + target_pk_quoted + " = " + through_quoted + "." + target_fk_quoted + " WHERE " + through_quoted + "." + source_fk_quoted + " = " + ph0

        params: list[Value] = [source_pk_val]
        rows: list[Row] = self.session.query_raw(sql, params)
        return target_model.decode_rows(rows)

    def load_relation_many_to_many[T](self: RelationLoader, rel: Relation, target_model: Model[T], source_pk_val: Value) -> list[T]:

        if rel.rel_type != REL_MANY_TO_MANY:
            raise RelationError("relation '" + rel.name + "' is not a many_to_many relation")
        return self.load_many_to_many[T](target_model, rel.through_table, rel.foreign_key, rel.target_foreign_key, source_pk_val, rel.primary_key)
